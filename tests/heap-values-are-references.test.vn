import { describe, it, expect } from "std:test";

enum Shade { Light, Dark }
enum Mark { Dot, Tick(int) }

class Holder {
    pair: (int, str) = (0, "");
    shade: Shade = Shade.Light;
    mark: Mark = Mark.Dot;
    pick: (x: int) => int = (x: int): int => x;
    big: bigint = 1n;
    dec: decimal = 1.5d;
    span: Range<int> = 0..3;
    maybe: (int, int)? = null;
    constructor(n: int) {
        this.pair = (n, "p" + n.toString());
        this.shade = n % 2 == 0 ? Shade.Dark : Shade.Light;
        this.mark = n % 3 == 0 ? Mark.Tick(n) : Mark.Dot;
        this.pick = (x: int): int => x + n;
        this.big = 10n;
        this.span = 0..n;
    }
}

function score(hs: Holder[]): int {
    let t = 0;
    for (const h in hs) {
        t = t + h.pair[0] + h.pick(1);
        if (h.shade == Shade.Dark) { t = t + 1 }
        if (h.mark != Mark.Dot) { t = t + 3 }
        for (const i in h.span) { t = t + i }
    }
    return t
}

function grow(a: bigint, b: bigint): bigint { return a + b }
function widen(a: decimal, b: decimal): decimal { return a + b }

await describe("356 heap values are references", async () => {
    await it("a field holding a heap value keeps it through a reference", async () => {
        const hs: Holder[] = [];
        for (let i = 0; i < 400; i = i + 1) { hs.push(new Holder(i)) }
        expect(score(hs)).toBe(10747402);
        expect(hs[4].maybe).toBe(null);
        hs[3].maybe = (1, 2);
        expect(hs[3].maybe?.[1]).toBe(2);
        expect(hs[5].pair[1]).toBe("p5");
        expect(hs[6].mark == Mark.Tick(6)).toBe(true);
        expect(hs[7].dec.toString()).toBe("1.5");
        expect(hs[7].span.toArray().length).toBe(7);
        expect(hs[8].pick(2)).toBe(10);
        const copy = hs[9] with { shade: Shade.Dark, pair: (7, "z") };
        expect(copy.shade == Shade.Dark).toBe(true);
        expect(copy.pair[0]).toBe(7);
        expect(hs[9].shade == Shade.Light).toBe(true);
    });

    await it("a bigint and a decimal travel as references through compiled calls", async () => {
        let acc: bigint = 0n;
        for (let i = 0; i < 500; i = i + 1) { acc = grow(acc, 10n) }
        expect(acc.toString()).toBe("5000");
        let sum: decimal = 0.0d;
        for (let i = 0; i < 500; i = i + 1) { sum = widen(sum, 0.5d) }
        expect(sum.toString()).toBe("250.0");
    });
});
