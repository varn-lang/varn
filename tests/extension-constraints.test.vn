import { describe, it, expect } from "std:test";

interface Sized {
    size(): int
}
class Box implements Sized {
    size(): int {
        return 3
    }
}

extension<T extends Sized> on T[] {
    total(): int {
        let n = 0
        for(const x in this) {
            n += x.size()
        }
        return n
    }
}

extension<T extends Sized> on Map<str, T> {
    biggest(): int {
        let best = 0
        for(const x in this.values()) {
            if(x.size() > best) {
                best = x.size()
            }
        }
        return best
    }
}

await describe("366 an extension exists only where its constraints hold", async () => {
    await it("a constrained extension reaches the members of the constraint", () => {
        const boxes: Box[] = [new Box(), new Box()]
        expect(boxes.total()).toBe(6)
    })

    await it("a constraint inside a generic receiver is checked against the bound type", () => {
        const byName = new Map<str, Box>()
        byName.set("a", new Box())
        expect(byName.biggest()).toBe(3)
    })
})
