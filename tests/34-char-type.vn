import { describe, it, expect } from "std:test";
import { Csv, Json } from "std:encoding";



// is char narrowing
function describeChar(c: char): str {
    if (c is char) return "yes"
    return "no"
}
class Glyph {
    mark: char = '?';
    constructor(mark: char) { this.mark = mark; }
}

function sameBool(a: bool, b: bool): bool { return a == b }
function differ(a: char, b: char): bool { return a != b }
function occurrences(text: str, target: char): int {
    let n = 0
    for (const c of text.chars()) { if (c == target) { n = n + 1 } }
    return n
}

function successor(c: char): char { return char.fromCode(c.charCodeAt() + 1) }
function choose(first: bool, a: char, b: char): char { return first ? a : b }
function marker(c: char = '*'): char { return c }

interface Marked { mut mark: char }
function readMark(m: Marked): char { return m.mark }
function writeMark(m: Marked, c: char): void { m.mark = c }
class Cell {
    mark: char = '?';
    flag: bool = false;
    code: int = 0;
    note: char? = null;
    constructor(mark: char, code: int) { this.mark = mark; this.code = code; }
    bump(): void { this.mark = char.fromCode(this.mark.charCodeAt() + 1) }
}
function markedTotal(cells: Cell[]): int {
    let t = 0
    for (const c of cells) { if (c.mark == 'b') { t = t + c.code } }
    return t
}

function alternating(n: int): char[] {
    const out: char[] = []
    for (let i = 0; i < n; i = i + 1) { out.push(i % 2 == 0 ? 'a' : 'z') }
    return out
}
function countOf(xs: char[], c: char): int {
    let k = 0
    for (let i = 0; i < xs.length; i = i + 1) { if (xs[i] == c) { k = k + 1 } }
    return k
}
function advanceAll(xs: char[]): void {
    for (let i = 0; i < xs.length; i = i + 1) { xs[i] = char.fromCode(xs[i].charCodeAt() + 1) }
}

await describe("34 char type", async () => {
    await it("tests", async () => {
        
        // Literals and basic identity
        const a: char = 'a'
        const z: char = 'z'
        const excl: char = '!'
        expect(a).toBe('a')
        expect(a != z).toBeTruthy()
        expect('A'.charCodeAt()).toBe(65)
        expect(char.fromCode(65)).toBe('A')
        expect(char.fromCode(122)).toBe('z')
        
        // Classification
        expect('a'.isAlphabetic()).toBeTruthy()
        expect(!('1'.isAlphabetic())).toBeTruthy()
        expect('a'.isAlphanumeric()).toBeTruthy()
        expect('7'.isAlphanumeric()).toBeTruthy()
        expect('5'.isDigit()).toBeTruthy()
        expect(!('a'.isDigit())).toBeTruthy()
        expect(' '.isWhitespace()).toBeTruthy()
        expect(!('a'.isWhitespace())).toBeTruthy()
        expect('A'.isUppercase()).toBeTruthy()
        expect(!('a'.isUppercase())).toBeTruthy()
        expect('a'.isLowercase()).toBeTruthy()
        expect(!('A'.isLowercase())).toBeTruthy()
        expect('a'.isAscii()).toBeTruthy()
        expect('.'.isPunctuation()).toBeTruthy()
        expect(!('a'.isPunctuation())).toBeTruthy()
        
        // Case conversion
        expect('a'.toUppercase()).toBe('A')
        expect('A'.toLowercase()).toBe('a')
        
        // toString
        expect('x'.toString()).toBe("x")
        expect(describeChar('q')).toBe("yes")
        
        // chars in array
        const vowels: char[] = ['a', 'e', 'i', 'o', 'u']
        expect(vowels.length).toBe(5)
        expect(vowels[0]).toBe('a')
        expect(vowels[4]).toBe('u')
        
        // char in loop
        let digitCount = 0
        const sample: char[] = ['1', 'a', '2', 'b', '3']
        for (const ch of sample) {
            if (ch.isDigit()) digitCount = digitCount + 1
        }
        expect(digitCount).toBe(3)
        
        // round-trip: codePoint -> char -> str
        const codes: int[] = [72, 101, 108, 108, 111]
        let built = ""
        for (const code of codes) {
            built = built + char.fromCode(code).toString()
        }
        expect(built).toBe("Hello")
        
    });

    await it("a char is an immediate value wherever it travels", async () => {
        const held: dynamic = 'q'
        expect(held is char).toBe(true)
        expect(held::type).toBe("char")
        const seen = new Set<char>()
        seen.add('x')
        seen.add('x')
        expect(seen.size).toBe(1)
        const counts = new Map<char, int>()
        counts.set('k', 2)
        expect(counts.get('k')).toBe(2)
        const glyphs: Glyph[] = []
        for (let i = 0; i < 200; i = i + 1) { glyphs.push(new Glyph(char.fromCode(65 + i % 26))) }
        expect(glyphs[27].mark).toBe('B')
        expect(glyphs[27].mark == 'B').toBe(true)
    });

    await it("bool and char values compare with their own typed equality", async () => {
        let agree = 0
        for (let i = 0; i < 3000; i = i + 1) {
            if (sameBool(i % 2 == 0, i % 3 == 0)) { agree = agree + 1 }
            if (differ('a', i % 2 == 0 ? 'a' : 'b')) { agree = agree + 1 }
        }
        expect(agree).toBe(3000)
        expect(occurrences("banana", 'a')).toBe(3)
        expect(sameBool(true, false)).toBe(false)
        expect(differ('x', 'x')).toBe(false)
    });

    await it("a char travels natively through compiled calls", async () => {
        let last: char = 'a'
        for (let i = 0; i < 5000; i = i + 1) { last = choose(i % 2 == 0, successor('a'), 'a') }
        expect(last).toBe('a')
        expect(successor('y')).toBe('z')
        expect(marker()).toBe('*')
        expect(marker('#')).toBe('#')
        const held: dynamic = 'q'
        const narrowed: char = held as char
        expect(narrowed == 'q').toBe(true)
    });

    await it("a char field holds its code point in four bytes", async () => {
        const cells: Cell[] = []
        for (let i = 0; i < 3000; i = i + 1) { cells.push(new Cell(i % 2 == 0 ? 'a' : 'b', i)) }
        for (const c of cells) { c.bump() }
        expect(markedTotal(cells)).toBe(2248500)
        let viaInterface: char = 'x'
        for (let i = 0; i < 2000; i = i + 1) { viaInterface = readMark(cells[i]) }
        expect(viaInterface).toBe('c')
        writeMark(cells[0], '😀')
        expect(cells[0].mark).toBe('😀')
        const copy = cells[1] with { mark: 'z' }
        expect(copy.mark).toBe('z')
        expect(cells[1].mark).toBe('c')
        expect(cells[1].note).toBe(null)
        cells[1].note = 'n'
        expect(cells[1].note).toBe('n')
        expect(cells[2].flag).toBe(false)
        expect(cells[2].code).toBe(2)
    });

    await it("a char array stores its elements unboxed", async () => {
        let total = 0
        for (let r = 0; r < 300; r = r + 1) {
            const xs = alternating(50)
            advanceAll(xs)
            total = total + countOf(xs, 'b') + countOf(xs, '{') * 2
        }
        expect(total).toBe(22500)
        const wide: char[] = ['h', 'é', '😀']
        expect(wide[2]).toBe('😀')
        wide[0] = 'ß'
        expect(wide[0]).toBe('ß')
        expect(wide.pop()).toBe('😀')
        expect(wide.length).toBe(2)
        const grown: char[] = []
        grown.push('x')
        grown[0] = 'k'
        expect(grown.pop()).toBe('k')
        expect(grown.length).toBe(0)
        const mixed: (char | int)[] = ['q', 1]
        mixed.push('w')
        expect(mixed.length).toBe(3)
        expect(mixed[0]).toBe('q')
        expect(mixed[1]).toBe(1)
    });

    await it("a char serializes as a one-character string", async () => {
        const wide: char[] = ['h', 'é', '😀']
        expect(Json.stringify(wide)).toBe("[\"h\",\"é\",\"😀\"]")
        expect(Json.stringify(new Glyph('"'))).toBe("{\"mark\":\"\\\"\"}")
        const rows: char[][] = [['a', ','], ['b', 'c']]
        expect(Csv.stringify(rows)).toBe("a,\",\"\nb,c\n")
    });
});
