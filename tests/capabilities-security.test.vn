import { describe, it, expect } from "std:test";
import { readText, writeText, remove, exists } from "std:fs";
import { Env } from "std:env";
import { platform, cwd } from "std:sys";

await describe("80 capabilities security", async () => {
    await it("tests", async () => {
        // ============================================================================
        // Test 80: Sistema de Capacidades y Seguridad de Frontera Host (Host Boundary)
        // ============================================================================

        // 1. Verificación de operaciones permitidas por defecto
        const currentPlatform = platform();
        expect(currentPlatform.length > 0).toBeTruthy();

        const currentCwd = cwd();
        expect(currentCwd.length > 0).toBeTruthy();

        // 2. Comprobación de existencia: un fichero ausente reporta false sin error.
        // (Hermético al CWD: la matriz corre cada cuadrante en su propio
        // directorio de trabajo.)
        expect(exists("test_cap_security_absent.tmp")).toBe(false);

        // 3. Comprobación de ciclo de vida seguro de escritura y borrado
        const tempFile = "test_cap_security.tmp";
        writeText(tempFile, "security_payload_ok");
        expect(exists(tempFile)).toBe(true);

        const readBack = readText(tempFile);
        expect(readBack).toBe("security_payload_ok");

        remove(tempFile);
        expect(exists(tempFile)).toBe(false);

        // 4. Comprobación de lectura de variables de entorno
        const osVal = Env.get("OS");
        // En Windows OS es "Windows_NT", en Unix puede estar ausente ("" o null) pero no debe crashear
        expect(osVal::type == "str").toBeTruthy();
    });
});
