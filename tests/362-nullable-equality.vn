import { describe, it, expect } from "std:test";

let calls = 0
function three(): int? {
    calls = calls + 1
    return 3
}

await describe("362 nullable equality", async () => {
    await it("an absent value is not equal to a present one", () => {
        const n: int? = null
        expect(n == 0).toBe(false)
        expect(n != 0).toBe(true)
        expect(0 == n).toBe(false)
        const s: str? = null
        expect(s == "a").toBe(false)
        const b: bool? = null
        expect(b == false).toBe(false)
        expect(b != false).toBe(true)
    })
    await it("a present value compares by its content", () => {
        const m: int? = 5
        expect(m == 5).toBe(true)
        expect(m != 5).toBe(false)
        expect(m == 6).toBe(false)
        const f: float? = 1.5
        expect(f == 1.5).toBe(true)
    })
    await it("the nullable side is evaluated once", () => {
        expect(three() == 3).toBe(true)
        expect(calls).toBe(1)
    })
})
