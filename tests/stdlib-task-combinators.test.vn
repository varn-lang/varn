import { Task, TaskGroup, delay } from "std:task";
import { describe, it, expect } from "std:test";

const trackerArray = [false];

await describe("97 stdlib task combinators", async () => {
    await it("1. Task.all", async () => {
        const t1 = (async () => {
            await delay(10);
            return 100;
        })();
        const t2 = (async () => {
            await delay(5);
            return 200;
        })();
        const allRes = await Task.all([t1, t2]);
        expect(allRes.length).toBe(2);
        expect(allRes[0]).toBe(100);
        expect(allRes[1]).toBe(200);
    });

    await it("2. Task.allSettled", async () => {
        const okTask = (async () => {
            return "success";
        })();
        const errTask = (async () => {
            throw new Error("failure");
        })();
        const settled = await Task.allSettled([okTask, errTask]);
        expect(settled.length).toBe(2);
        expect(settled[0].unwrap()).toBe("success");
        expect(settled[1].isErr()).toBe(true);
    });

    await it("3. Task.race", async () => {
        const fastTask = (async () => {
            await delay(5);
            return "first";
        })();
        const slowTask = (async () => {
            await delay(100);
            return "second";
        })();
        const winner = await Task.race([fastTask, slowTask]);
        expect(winner).toBe("first");
    });

    await it("4. TaskGroup concurrency and lifecycle hooks", async () => {
        const tg = new TaskGroup<int>();
        tg.finally(() => {
            trackerArray[0] = true;
        });
        _ = tg.spawn((async () => {
            return 1;
        })());
        _ = tg.spawn((async () => {
            return 2;
        })());
        const groupResults = await tg.join();
        expect(groupResults.length).toBe(2);
        expect(groupResults[0]).toBe(1);
        expect(groupResults[1]).toBe(2);
        expect(trackerArray[0]).toBeTruthy();
    });
});
