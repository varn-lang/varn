import { Database } from "std:sqlite";
import { describe, it, expect } from "std:test";

// Test Suite 86: Tagged Template Functions End-to-End
function customTag(strings: str[], ...values: (str | int)[]): str {
    let res = "";
    for(let i = 0; i < strings.length; i = i + 1) {
        res = res + strings[i];
        if(i < values.length) {
            res = res + `[${values[i]}]`;
        }
    }
    return res;
}

class Formatter {
    prefix: str = ">> ";

    format(strings: str[], ...values: (str | int)[]): str {
        let res = this.prefix;
        for(let i = 0; i < strings.length; i = i + 1) {
            res = res + strings[i];
            if(i < values.length) {
                res = res + `${values[i]}`;
            }
        }
        return res;
    }
}
await describe("86 tagged templates", async () => {
    await it("Free-function tagged template", async () => {
        const name = "Varn";
        const version = 1;
        const output = customTag `Language: ${name}, Version: ${version}!`;
        expect(output).toBe("Language: [Varn], Version: [1]!");

        const rawOnly = customTag `No interpolations here.`;
        expect(rawOnly).toBe("No interpolations here.");
    });
    await it("Class-method tagged template", async () => {
        const fmt = new Formatter();
        const user = "Alice";
        const score = 95;
        const formatted = fmt.format `Player ${user} scored ${score} points`;
        expect(formatted).toBe(">> Player Alice scored 95 points");
    });
    await it("Safe SQL parameterized queries with db.sql and db.sqlOne", async () => {
        const db = new Database(":memory:");
        db.exec(
            "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, role TEXT, active INTEGER);",
        );
        db.exec("INSERT INTO users VALUES (1, 'Alice', 'admin', 1);");
        db.exec("INSERT INTO users VALUES (2, 'Bob', 'editor', 1);");
        db.exec("INSERT INTO users VALUES (3, 'Charlie', 'viewer', 0);");
        const targetRole = "admin";
        const isActive = 1;
        const rows = db.sql `SELECT id, name, role FROM users WHERE role = ${targetRole} AND active = ${isActive};`;
        expect(rows.length).toBe(1);
        expect(rows[0]["name"]).toBe("Alice");
        expect(rows[0]["id"]).toBe(1);
        const targetId = 2;
        const singleUser = db.sqlOne `SELECT id, name, role FROM users WHERE id = ${targetId};`;
        expect(singleUser != null).toBe(true);
        if(singleUser != null) {
            expect(singleUser["name"]).toBe("Bob");
            expect(singleUser["role"]).toBe("editor");
        }
        db.close();
    });
});
