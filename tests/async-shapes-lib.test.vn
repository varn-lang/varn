// Companion module for async-shapes.test.vn. The point is the module boundary:
// an async method or function only loses its `Task` wrap when the checker sees
// it from another module.
export class ImportedAsyncBox<T = int> {
    items: Array<T>;

    constructor() {
        this.items = [];
    }

    async method(): Task<int> {
        return 9;
    }

    async all(): Task<Array<int>> {
        return [10];
    }
}

export async function importedAsyncFn(): Task<int> {
    return 11;
}

export namespace AsyncNs {
    export async function fn(): Task<int> {
        return 12;
    }
}

export async function asyncImportedMethod(): Task<int> {
    return 13;
}
