import { describe, it, expect } from "std:test";

class Point {
    n: int
    constructor(n: int) { this.n = n }
}

function present(n: int?): int { if (n != null) { return 1 } return 0 }
function presentStr(s: str?): int { if (s != null) { return 1 } return 0 }
function isTrue(b: bool?): int { if (b == true) { return 1 } return 0 }
function fromDynamic(d: dynamic): int { if (d as bool) { return 1 } return 0 }
function walk(p: Point?): int { let c = 0; let at = p; while (at != null) { c = c + at.n; at = null } return c }
function absent(n: int?): bool { return n == null }
function pick(n: float?): int { return n != null ? 5 : 6 }
function narrowed(n: int?): int { if (n != null) { return n + 1 } else { return n ?? -1 } }

function orDefault(n: int?): int { return n ?? 7 }
function assignDefault(n: int?): int { let x = n; x ??= 9; return x }
function strDefault(s: str?): str { return s ?? "vacio" }
function throughPoint(p: Point?): int { return p?.n ?? -1 }
function bools(a: bool, b: bool): bool { return a && b || !a }

let calls = 0
function counted(v: bool): bool { calls = calls + 1; return v }
function orShort(): int { calls = 0; const r = counted(true) || counted(false); return (r ? 10 : 0) + calls }
function orBoth(): int { calls = 0; const r = counted(false) || counted(true); return (r ? 10 : 0) + calls }
function andShort(): int { calls = 0; const r = counted(false) && counted(true); return (r ? 10 : 0) + calls }

await describe("186 conditions are booleans", async () => {
    await it("presence is tested with != null, whatever the value", () => {
        for (let r = 0; r < 300; r = r + 1) {
            present(r); presentStr("a"); isTrue(true); walk(new Point(3)); pick(1.0); absent(r); narrowed(r)
        }
        expect(present(null)).toBe(0)
        expect(present(0)).toBe(1)
        expect(presentStr("")).toBe(1)
        expect(presentStr(null)).toBe(0)
        expect(isTrue(null)).toBe(0)
        expect(isTrue(false)).toBe(0)
        expect(isTrue(true)).toBe(1)
        expect(walk(new Point(3))).toBe(3)
        expect(walk(null)).toBe(0)
        expect(absent(null)).toBe(true)
        expect(absent(0)).toBe(false)
        expect(pick(null)).toBe(6)
        expect(pick(0.0)).toBe(5)
        expect(narrowed(null)).toBe(-1)
        expect(narrowed(0)).toBe(1)
    })

    await it("a dynamic condition is cast to bool", () => {
        expect(fromDynamic(true)).toBe(1)
        expect(fromDynamic(false)).toBe(0)
    })

    await it("defaults are written with ??", () => {
        for (let r = 0; r < 300; r = r + 1) {
            orDefault(r); assignDefault(r); strDefault(null); throughPoint(null); bools(true, false)
        }
        expect(orDefault(null)).toBe(7)
        expect(orDefault(0)).toBe(0)
        expect(assignDefault(null)).toBe(9)
        expect(assignDefault(0)).toBe(0)
        expect(strDefault(null)).toBe("vacio")
        expect(strDefault("")).toBe("")
        expect(throughPoint(null)).toBe(-1)
        expect(throughPoint(new Point(0))).toBe(0)
        expect(bools(true, true)).toBe(true)
        expect(bools(true, false)).toBe(false)
        expect(bools(false, false)).toBe(true)
    })

    await it("&& and || are boolean and evaluate the right side only when needed", () => {
        for (let r = 0; r < 300; r = r + 1) { orShort(); orBoth(); andShort() }
        expect(orShort()).toBe(11)
        expect(orBoth()).toBe(12)
        expect(andShort()).toBe(1)
    })
})
