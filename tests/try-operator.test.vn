import { describe, it, expect } from "std:test";

// `try` works on the core Result and on nullable types.
function parsePositive(n: int): Result<int, str> {
    if(n <= 0) {
        return Result.Err("must be positive");
    }
    return Result.Ok(n * 2);
}

const testDirect = parsePositive(5);
const _testDirectVal = match (testDirect) {
    Ok(val) => val,
    Err(_) => 0
};

function computeResult(a: int, b: int): Result<int, str> {
    const x: int = try parsePositive(a);
    const y: int = try parsePositive(b);
    return Result.Ok(x + y);
}

const okRes = computeResult(5, 10);

const errRes = computeResult(-2, 10);

function findUserId(name: str): int? {
    if(name == "alice") {
        return 101;
    }
    return null;
}

function getUserScore(name: str): int? {
    const uid: int = try findUserId(name);
    return uid + 50;
}

const someOpt = getUserScore("alice");

const noneOpt = getUserScore("bob");

function getSuffix(s: str?): str? {
    const nonNullStr: str = try s;
    return nonNullStr + "_suffix";
}

const suffixedOk = getSuffix("test");

const suffixedNull = getSuffix(null);

const cond = true;
const ternaryUnaryNeg = cond ? -1 : 1;

const ternaryUnaryNot = cond ? !false : false;

const optChain: str? = "hello";
const optLen = optChain?.length ?? 0;
await describe("109 try operator", async () => {
    await it("group 1 part 1a", async () => {
        const okVal = match (okRes) {
            Ok(v) => v,
            Err(_) => 0
        };
        const errMsg = match (errRes) {
            Ok(_) => "unexpected",
            Err(e) => e
        };
        expect(okVal).toBe(30);
        expect(errMsg).toBe("must be positive");
    });

    await it("group 1 part 1b", async () => {
        const someVal = someOpt ?? -1;
        const isNone = noneOpt == null;
        expect(someVal).toBe(151);
        expect(isNone).toBe(true);
        expect(suffixedOk).toBe("test_suffix");
    });

    await it("group 1 part 2", async () => {
        expect(suffixedNull == null).toBeTruthy();
        expect(ternaryUnaryNeg == -1).toBeTruthy();
        expect(ternaryUnaryNot == true).toBeTruthy();
        expect(optLen == 5).toBeTruthy();
    });
});
