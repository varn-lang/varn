import { describe, it, expect } from "std:test";

// `try` works on the core Result and on nullable types.
function parse_positive(n: int): Result<int, str> {
    if(n <= 0) {
        return Result.Err("must be positive");
    }
    return Result.Ok(n * 2);
}

const test_direct = parse_positive(5);
const _test_direct_val = match (test_direct) {
    Ok(val) => val,
    Err(_) => 0
};

function compute_result(a: int, b: int): Result<int, str> {
    const x: int = try parse_positive(a);
    const y: int = try parse_positive(b);
    return Result.Ok(x + y);
}

const ok_res = compute_result(5, 10);

const err_res = compute_result(-2, 10);

function find_user_id(name: str): int? {
    if(name == "alice") {
        return 101;
    }
    return null;
}

function get_user_score(name: str): int? {
    const uid: int = try find_user_id(name);
    return uid + 50;
}

const some_opt = get_user_score("alice");

const none_opt = get_user_score("bob");

function get_suffix(s: str?): str? {
    const non_null_str: str = try s;
    return non_null_str + "_suffix";
}

const suffixed_ok = get_suffix("test");

const suffixed_null = get_suffix(null);

const cond = true;
const ternary_unary_neg = cond ? -1 : 1;

const ternary_unary_not = cond ? !false : false;

const opt_chain: str? = "hello";
const opt_len = opt_chain?.length ?? 0;
await describe("109 try operator", async () => {
    await it("group 1 part 1a", async () => {
        const ok_val = match (ok_res) {
            Ok(v) => v,
            Err(_) => 0
        };
        const err_msg = match (err_res) {
            Ok(_) => "unexpected",
            Err(e) => e
        };
        expect(ok_val).toBe(30);
        expect(err_msg).toBe("must be positive");
    });

    await it("group 1 part 1b", async () => {
        const some_val = some_opt ?? -1;
        const is_none = none_opt == null;
        expect(some_val).toBe(151);
        expect(is_none).toBe(true);
        expect(suffixed_ok).toBe("test_suffix");
    });

    await it("group 1 part 2", async () => {
        expect(suffixed_null == null).toBeTruthy();
        expect(ternary_unary_neg == -1).toBeTruthy();
        expect(ternary_unary_not == true).toBeTruthy();
        expect(opt_len == 5).toBeTruthy();
    });
});
