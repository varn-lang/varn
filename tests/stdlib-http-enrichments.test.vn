import {
    HttpServer,
    Request,
    RequestInit,
    Response,
    json,
    fetch,
    HttpMethod,
} from "std:http";
import { JsonValue } from "std:encoding";
import { describe, it, expect } from "std:test";
import { delay } from "std:task";

// 1. Request Cookies parsing
const reqWithCookies = new Request(
    "http://localhost:3000/api",
    new RequestInit(
        method: HttpMethod.GET,
        headers: new Map<str,
        str>([#["cookie", "session_id=xyz789; theme=dark; logged_in=true"]]),
    ),
);

// 2. Request.json and Request.formData
const reqJson = new Request(
    "http://localhost:3000/api",
    new RequestInit(
        method: HttpMethod.POST,
        headers: new Map<str,
        str>([#["content-type", "application/json"]]),
        body: "{\"name\":\"Varn\",\"version\":1}",
    ),
);

const parsedJson = reqJson.json() as Map<str, JsonValue>;

const reqForm = new Request(
    "http://localhost:3000/api",
    new RequestInit(
        method: HttpMethod.POST,
        headers: new Map<str,
        str>([#["content-type", "application/x-www-form-urlencoded"]]),
        body: "user=alice&action=login",
    ),
);

const parsedForm = reqForm.formData();

// 3. Middleware Pipeline
const server = new HttpServer();
const middlewareLog: str[] = [];
await describe("100 stdlib http enrichments", async () => {
    await it("group 1 part 1", async () => {
        expect(reqWithCookies.cookies["session_id"]).toBe("xyz789");
        expect(reqWithCookies.cookies["theme"]).toBe("dark");
        expect(reqWithCookies.cookies["logged_in"]).toBe("true");
        expect(parsedJson["name"]).toBe("Varn");
    });

    await it("group 1 part 2", async () => {
        expect(parsedJson["version"]).toBe(1);
        expect(parsedForm["user"]).toBe("alice");
        expect(parsedForm["action"]).toBe("login");
        server.use(async (req: Request, next: () => Task<Response?>) => {
            middlewareLog.push("mw1_before");
            const res = await next();
            middlewareLog.push("mw1_after");
            return res;
        });
        server.use(async (req: Request, next: () => Task<Response?>) => {
            middlewareLog.push("mw2_before");
            const res = await next();
            middlewareLog.push("mw2_after");
            return res;
        });
        server.get("/test", async (_req: Request) => {
            middlewareLog.push("handler");
            return json(#{ ok: true });
        });
    });

    await it("middleware executes on live request", async () => {
        server.listen(0);
        await delay(150);
        const res = await fetch(`http://127.0.0.1:${server.port}/test`);
        expect(res.status).toBe(200);
        server.close();
        expect(middlewareLog.length).toBe(5);
        expect(middlewareLog[0]).toBe("mw1_before");
        expect(middlewareLog[1]).toBe("mw2_before");
        expect(middlewareLog[2]).toBe("handler");
        expect(middlewareLog[3]).toBe("mw2_after");
        expect(middlewareLog[4]).toBe("mw1_after");
    });
});
