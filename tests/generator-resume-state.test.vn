import { describe, it, expect } from "std:test";

function* counter(step: int): Generator<int> {
    let n = 0;
    while(true) {
        n = n + step;
        yield n;
    }
}

function* closureOverLocal(): Generator<int> {
    let total = 0;
    const bump = (by: int): int => {
        total = total + by;
        return total;
    };
    yield bump(1);
    yield bump(10);
    total = total + 100;
    yield bump(1000);
}

function* guardedAcrossYield(limit: int): Generator<int> {
    for(let i = 0; i < limit; i = i + 1) {
        try {
            yield i;
            if(i % 3 == 2) {
                throw new Error("third")
            }
        } catch (e) {
            yield 100 + i;
        }
    }
}

function* inner(base: int): Generator<int> {
    yield base;
    yield base + 1;
}

function* outer(): Generator<int> {
    for(let k = 0; k < 4; k = k + 1) {
        const it = inner(k * 10);
        while(const v = it.next()) {
            yield v;
        }
    }
}

function* fails(): Generator<int> {
    yield 1;
    throw new Error("boom");
}

function* withFinally(log: str[]): Generator<int> {
    try {
        yield 1;
        yield 2;
    } finally {
        log.push("closed");
    }
}

await describe("generator resume state", async () => {
    await it("registers survive many suspend and resume cycles", async () => {
        const g = counter(3);
        let last = 0;
        for(let i = 0; i < 5000; i = i + 1) {
            last = g.next()!
        }
        expect(last).toBe(15000);
    });

    await it("a closure over a generator local stays shared across yields", async () => {
        const g = closureOverLocal();
        expect(g.next()!).toBe(1);
        expect(g.next()!).toBe(11);
        expect(g.next()!).toBe(1111);
    });

    await it("a try region stays armed across a yield", async () => {
        const g = guardedAcrossYield(6);
        const seen: int[] = [];
        while(const v = g.next()) {
            seen.push(v)
        }
        expect(seen.join(",")).toBe("0,1,2,102,3,4,5,105");
    });

    await it("generators resumed from inside another generator keep their own state", async () => {
        const seen: int[] = [];
        const g = outer();
        while(const v = g.next()) {
            seen.push(v)
        }
        expect(seen.join(",")).toBe("0,1,10,11,20,21,30,31");
    });

    await it("an error thrown by a generator reaches the caller and ends it", async () => {
        const g = fails();
        expect(g.next()!).toBe(1);
        let caught = "";
        try {
            g.next()
        } catch (e) {
            caught = e.message
        }
        expect(caught).toBe("boom");
        expect(g.next() == null).toBeTruthy();
    });

    await it("closing a suspended generator runs its finally block", async () => {
        const log: str[] = [];
        const g = withFinally(log);
        expect(g.next()!).toBe(1);
        g.close();
        expect(log.join(",")).toBe("closed");
        expect(g.next() == null).toBeTruthy();
    });
});
