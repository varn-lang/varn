import { describe, it, expect } from "std:test";

function overflows(f: () => bool): bool {
    try {
        f()
        return false
    } catch (e) {
        return e is IntegerOverflow
    }
}

function addU8(a: u8, b: u8): u8 { return a + b }
function subU8(a: u8, b: u8): u8 { return a - b }
function mulI16(a: i16, b: i16): i16 { return a * b }
function addF32(a: f32, b: f32): f32 { return a + b }
function addU64(a: u64, b: u64): u64 { return a + b }
function mulU64(a: u64, b: u64): u64 { return a * b }

class Counter {
    total: u64
    constructor(total: u64) { this.total = total }
    add(by: u64): void { this.total = this.total + by }
}

const TOP: u64 = 18446744073709551615n as u64;
let checksum: u64 = 0;
let turns: int = 0;
while (turns < 300) {
    checksum = (checksum + 7) ^ (turns as u64);
    turns += 1
}

class Pixel {
    r: u8
    g: u8
    constructor(r: u8, g: u8) { this.r = r; this.g = g }
    brighten(by: u8): void { this.r = this.r + by }
}

let hot: u8 = 0
let rounds: int = 0
while (rounds < 400) {
    hot = hot + 1 as u8
    if (hot == 200) { hot = 0 }
    rounds += 1
}

await describe("359 fixed-width numbers", async () => {
    await it("arithmetic stays inside the width", () => {
        expect(addU8(200, 55)).toBe(255);
        expect(subU8(255, 255)).toBe(0);
        expect(mulI16(-128, 255)).toBe(-32640);
        const lowest: i8 = -128;
        expect(lowest + 127).toBe(-1);
        const big: u32 = 4294967295;
        expect(big - 1).toBe(4294967294);
    });

    await it("leaving the width is an IntegerOverflow", () => {
        expect(overflows(() => addU8(200, 56) == 0)).toBe(true);
        expect(overflows(() => subU8(0, 1) == 0)).toBe(true);
        expect(overflows(() => mulI16(300, 300) == 0)).toBe(true);
        const lowest: i8 = -128;
        expect(overflows(() => -lowest == 0)).toBe(true);
        expect(overflows(() => lowest / -1 == 0)).toBe(true);
        const small: u8 = 1;
        expect(overflows(() => small << 8 == 0)).toBe(true);
        const top: u32 = 4294967295;
        expect(overflows(() => top + 1 == 0)).toBe(true);
    });

    await it("the same operation behaves the same when hot", () => {
        for (let i = 0; i < 300; i += 1) {
            expect(addU8(1, 2)).toBe(3);
        }
        expect(overflows(() => addU8(255, 1) == 0)).toBe(true);
        expect(hot).toBe(0);
    });

    await it("as converts explicitly and checks the range", () => {
        expect(300 as u16).toBe(300);
        expect(overflows(() => (300 as u8) == 0)).toBe(true);
        expect(overflows(() => (-1 as u8) == 0)).toBe(true);
        expect(overflows(() => (-1 as u32) == 0)).toBe(true);
        const wide: i8 = -5;
        expect(wide as int).toBe(-5);
        expect(overflows(() => (wide as u8) == 0)).toBe(true);
        expect(200 as u8 as int).toBe(200);
        expect(3.9 as u8).toBe(3);
        expect(overflows(() => (256.0 as u8) == 0)).toBe(true);
        expect(7 as u8 as float).toBe(7.0);
    });

    await it("bitwise operators keep the width", () => {
        const a: u8 = 0b1100_1100;
        const b: u8 = 0b1010_1010;
        expect(a & b).toBe(0b1000_1000);
        expect(a | b).toBe(0b1110_1110);
        expect(a ^ b).toBe(0b0110_0110);
        expect(~a).toBe(0b0011_0011);
        const s: i8 = -1;
        expect(~s).toBe(0);
        expect(a >> 2).toBe(0b0011_0011);
    });

    await it("comparisons are by value", () => {
        const a: u8 = 10;
        const b: u8 = 200;
        expect(a < b).toBe(true);
        expect(a == 10).toBe(true);
        expect(b >= 200).toBe(true);
        const c: i32 = -2000000000;
        expect(c < 0).toBe(true);
    });

    await it("f32 rounds every result to 32 bits", () => {
        const tenth: f32 = 0.1;
        expect(tenth as float).toBe(0.10000000149011612);
        const million: f32 = 16777216.0;
        expect(addF32(million, 1.0) as float).toBe(16777216.0);
        expect(0.1 as f32 as float == 0.1).toBe(false);
        expect(addF32(0.5, 0.25) as float).toBe(0.75);
        const half: f32 = 3;
        expect((half / 2) as float).toBe(1.5);
    });

    await it("fields and parameters keep the width", () => {
        const p = new Pixel(250, 7);
        p.brighten(5);
        expect(p.r).toBe(255);
        expect(overflows(() => { p.brighten(1); return true })).toBe(true);
        expect(p.g + 1).toBe(8);
    });
    await it("u64 holds the whole unsigned range", () => {
        const edge: u64 = 9223372036854775807;
        expect(edge + 1).toBe(9223372036854775808n as u64);
        expect(addU64(TOP - 1, 1)).toBe(TOP);
        expect(TOP - TOP).toBe(0);
        expect(mulU64(4294967296, 4294967295)).toBe(18446744069414584320n as u64);
        expect(overflows(() => addU64(TOP, 1) == 0)).toBe(true);
        expect(overflows(() => mulU64(4294967296, 4294967296) == 0)).toBe(true);
        expect(overflows(() => (0 as u64) - 1 == 0)).toBe(true);
        expect(TOP / 2).toBe(9223372036854775807);
        expect(TOP % 10).toBe(5);
    });

    await it("u64 compares and prints as unsigned", () => {
        const big: u64 = 9223372036854775808n as u64;
        expect(big > 1).toBe(true);
        expect(big > 9223372036854775807).toBe(true);
        expect(TOP >= big).toBe(true);
        expect(big == big).toBe(true);
        expect(`${TOP}`).toBe("18446744073709551615");
        expect(`${big}`).toBe("9223372036854775808");
    });

    await it("u64 bit operators work on the 64 bit pattern", () => {
        expect(TOP & 255).toBe(255);
        expect(TOP ^ TOP).toBe(0);
        expect(TOP >> 60).toBe(15);
        expect(~(0 as u64)).toBe(TOP);
        expect(1 as u64 << 63).toBe(9223372036854775808n as u64);
        expect(overflows(() => (3 as u64 << 63) == 0)).toBe(true);
        expect((TOP | 0) == TOP).toBe(true);
    });

    await it("u64 converts explicitly and checks the range", () => {
        expect(5 as u64).toBe(5);
        expect(overflows(() => (-1 as u64) == 0)).toBe(true);
        expect(TOP as float).toBe(18446744073709551615.0);
        expect(overflows(() => (TOP as int) == 0)).toBe(true);
        expect(100 as u64 as u8).toBe(100);
        expect(overflows(() => (300 as u64 as u8) == 0)).toBe(true);
        expect(3.9 as u64).toBe(3);
        expect(overflows(() => (18446744073709551616n as u64) == 0)).toBe(true);
    });

    await it("u64 fields, parameters and hot loops keep the value", () => {
        const c = new Counter(TOP - 10);
        c.add(10);
        expect(c.total).toBe(TOP);
        expect(overflows(() => { c.add(1); return true })).toBe(true);
        expect(checksum > 0).toBe(true);
        const sums: u64[] = [];
        for (let i = 0; i < 50; i += 1) {
            sums.push(TOP - (i as u64));
        }
        expect(sums[49]).toBe(TOP - 49);
        expect(`${sums[0]}`).toBe("18446744073709551615");
    });
    await it("every width states its limits", () => {
        expect(u8.MAX_VALUE).toBe(255);
        expect(u8.MIN_VALUE).toBe(0);
        expect(i8.MIN_VALUE).toBe(-128);
        expect(i16.MAX_VALUE).toBe(32767);
        expect(u32.MAX_VALUE).toBe(4294967295);
        expect(i32.MIN_VALUE).toBe(-2147483648);
        expect(u64.MAX_VALUE).toBe(18446744073709551615n as u64);
        expect(u8.BITS).toBe(8);
        expect(u64.BITS).toBe(64);
        expect(f32.EPSILON as float).toBe(1.1920928955078125e-7);
    });

    await it("wrapping, saturating and checked arithmetic are explicit", () => {
        const a: u8 = 200;
        expect(a.wrappingAdd(100)).toBe(44);
        expect(a.saturatingAdd(100)).toBe(255);
        expect(a.checkedAdd(100) == null).toBe(true);
        expect(a.checkedAdd(50)).toBe(250);
        expect(a.wrappingMul(3)).toBe(88);
        const low: i8 = -128;
        expect(low.wrappingSub(1)).toBe(127);
        expect(low.saturatingSub(1)).toBe(-128);
        const top: u64 = u64.MAX_VALUE;
        expect(top.wrappingAdd(2)).toBe(1);
        expect(top.checkedMul(2) == null).toBe(true);
        expect(top.saturatingAdd(1)).toBe(top);
    });

    await it("division and remainder follow the declared rounding", () => {
        const a: i32 = -7;
        expect(a.div(2)).toBe(-3);
        expect(a.floorDiv(2)).toBe(-4);
        expect(a.ceilDiv(2)).toBe(-3);
        expect(a.rem(2)).toBe(-1);
        expect(a.mod(2)).toBe(1);
        expect(overflows(() => (a.div(0)) == 0)).toBe(false);
        const edge: i8 = -128;
        expect(overflows(() => edge.div(-1) == 0)).toBe(true);
    });

    await it("bit intrinsics act on the stored width", () => {
        const a: u8 = 0b1011_0001;
        expect(a.countOnes()).toBe(4);
        expect(a.leadingZeros()).toBe(0);
        expect(a.trailingZeros()).toBe(0);
        expect(a.rotateLeft(1)).toBe(0b0110_0011);
        expect(a.rotateRight(1)).toBe(0b1101_1000);
        const wide: u32 = 0x1234_5678;
        expect(wide.swapBytes()).toBe(0x7856_3412);
        expect((1 as u16).leadingZeros()).toBe(15);
    });

    await it("conversion and text methods", () => {
        const a: u8 = 200;
        expect(a.toString()).toBe("200");
        expect(a.toHex()).toBe("c8");
        expect(a.toBinary()).toBe("11001000");
        expect(a.toInt()).toBe(200);
        expect(a.toFloat()).toBe(200.0);
        expect(u8.parse("17")).toBe(17);
        expect(u8.tryParse("256") == null).toBe(true);
        expect(i16.tryParse("-5")).toBe(-5);
        expect((-5 as i16).abs()).toBe(5);
        expect(u64.MAX_VALUE.toString()).toBe("18446744073709551615");
        expect(overflows(() => u64.MAX_VALUE.toInt() == 0)).toBe(true);
        const f: f32 = 2.5;
        expect(f.floor() as float).toBe(2.0);
        expect(f.toFloat()).toBe(2.5);
    });
});
