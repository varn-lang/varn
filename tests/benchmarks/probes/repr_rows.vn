import { now } from "std:time";

class P3 {
    a: int;
    b: int;
    c: int;
    constructor(a: int, b: int, c: int) {
        this.a = a;
        this.b = b;
        this.c = c;
    }
}

const N = 1000000;
let checksum = 0;

function row(name: str, f: () => int) {
    let best = 1000000;
    for(let r = 0; r < 5; r = r + 1) {
        const t = now();
        checksum = checksum + f();
        const d = now() - t;
        if(d < best) {
            best = d;
        }
    }
    print(`${name} ${best}`);
}

row("loop_only", () => {
    const k: int[] = [];
    for(let i = 0; i < N; i = i + 1) {
        k.push(i);
    }
    return k.length;
});
row("instance3", () => {
    const k: P3[] = [];
    for(let i = 0; i < N; i = i + 1) {
        k.push(new P3(i, 2, 3));
    }
    return k.length;
});
row("objlit3", () => {
    const k: #{ a: int; b: int; c: int } [] = [];
    for(let i = 0; i < N; i = i + 1) {
        k.push(#{ a: i, b: 2, c: 3 });
    }
    return k.length;
});
row("arraylit3", () => {
    const k: int[][] = [];
    for(let i = 0; i < N; i = i + 1) {
        k.push([i, 2, 3]);
    }
    return k.length;
});
row("map3", () => {
    const k: Map<str, int>[] = [];
    for(let i = 0; i < N; i = i + 1) {
        k.push(new Map([#["a", i], #["b", 2], #["c", 3]]));
    }
    return k.length;
});
row("map_get_heapkey", () => {
    const m = new Map([
        #["authorization", "Bearer x"],
        #["content-type", "json"],
        #["user-agent", "probe"],
    ]);
    const keys = ["authorization", "content-type", "user-agent"];
    let total = 0;
    for(let i = 0; i < N * 2; i = i + 1) {
        total = total + m[keys[i % 3]]!.length;
    }
    return total;
});
row("strview", () => {
    const k: str[] = [];
    const base = "abcdefghijklmnopqrstuvwxyz0123456789";
    for(let i = 0; i < N; i = i + 1) {
        k.push(base.slice(i % 10, 20));
    }
    return k.length;
});
row("split5", () => {
    const k: str[][] = [];
    for(let i = 0; i < N / 2; i = i + 1) {
        k.push("/api/v1/orders/history/details".split("/"));
    }
    return k.length;
});
print(`checksum ${checksum}`);
