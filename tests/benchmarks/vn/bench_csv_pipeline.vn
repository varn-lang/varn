import { Csv } from "std:encoding";

type Sale = #{
    id: int,
    customer: str,
    product: str,
    category: str,
    quantity: int,
    unitPrice: float,
    status: str,
    timestamp: str,
};

// 1. Generate 50,000 transaction records in CSV format
const categories = ["Electronics", "Apparel", "Home", "Books", "Sports"];
const statuses = ["COMPLETED", "PENDING", "CANCELLED", "COMPLETED", "COMPLETED"];

const rows: str[] = [];
rows.push("id,customer,product,category,quantity,unitPrice,status,timestamp");

for(let i = 0; i < 50000; i = i + 1) {
    const cat = categories[i % 5];
    const stat = statuses[i % 5];
    const qty = (i % 10) + 1;
    const price = (((i % 200) + 5) as float) * 1.5;
    rows.push(
        `${i},Customer_${(i % 1000)},Product_${(i % 500)},${cat},${qty},${price},${stat},2026-08-21T12:00:00Z`,
    );
}

const csvText = rows.join("\n");

// 2. Real-world Data Ingestion, Filtering, Aggregation and Serialization Pipeline
const parsed = Csv.parse<Sale>(csvText);

const completedSales: Sale[] = [];
const categoryRevenue = new Map<str, float>();
let totalRevenue = 0.0;

for(let i = 0; i < parsed.length; i = i + 1) {
    const row = parsed[i];
    if(row.status == "COMPLETED") {
        const lineTotal: float = (row.quantity as float) * row.unitPrice;
        totalRevenue = totalRevenue + lineTotal;

        const catName: str = row.category;
        const currentRev = categoryRevenue.get(catName);
        if(currentRev == null) {
            categoryRevenue.set(catName, lineTotal);
        } else {
            categoryRevenue.set(catName, (currentRev as float) + lineTotal);
        }

        completedSales.push(row);
    }
}

const serializedExport = Csv.stringify(completedSales);

print(
    `CSV Pipeline: Completed Sales = ${completedSales.length}, Total Revenue = $${totalRevenue as int}, Export bytes = ${serializedExport.length}`,
);
