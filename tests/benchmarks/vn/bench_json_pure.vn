import { Json } from "std:encoding";

type Item = #{ id: int, name: str, active: bool, score: float };

const items: Item[] = [];
for(let i = 0; i < 50000; i = i + 1) {
    items.push(#{
        id: i,
        name: `Item_${i}`,
        active: (i % 2) == 0,
        score: ((i % 100) as float) * 1.25,
    });
}

const jsonStr = Json.stringify(items);

// Warmup and pure parse/stringify benchmark
const iterations = 20;
let parsed = Json.parse<Item[]>(jsonStr);
for(let k = 0; k < iterations; k = k + 1) {
    parsed = Json.parse<Item[]>(jsonStr);
    const _s = Json.stringify(parsed);
}

print(parsed.length);
let idSum = 0;
for(let i = 0; i < parsed.length; i = i + 1) {
    idSum = idSum + parsed[i].id;
}
print(idSum.toString());
