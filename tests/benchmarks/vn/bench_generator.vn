// B0 battery: generators (JIT-impossible today, interpreter baseline).
// Covers: ping-pong values, map/filter, loop-carry through resume,
// nested generators, upvalue captures, try outside yield.
// Every section prints a checksum; JIT vs NO_JIT must be bit-identical.
import { now } from "std:time";

function* pingpong() {
    let x = 0;
    while(true) {
        x = x + 1;
        yield x;
    }
}

function* rangeGen(start: int, end: int) {
    let i = start;
    while(i < end) {
        yield i;
        i = i + 1;
    }
}

function* fibGen() {
    let a = 0;
    let b = 1;
    while(true) {
        yield a;
        const tmp = a + b;
        a = b;
        b = tmp;
    }
}

function* nestedInner(n: int) {
    yield n * 10;
    yield n * 20;
}

function* nestedOuter() {
    yield 1;
    const inner = nestedInner(5);
    yield inner.next()! + 100;
    yield inner.next()! + 100;
}

function makeCounter(step: int): () => Generator<int> {
    const base = step * 1000;
    function* counter() {
        let i = 0;
        while(true) {
            yield base + i;
            i = i + 1;
        }
    }
    return counter;
}

function* guarded() {
    yield 7;
    yield 8;
}

const PING_N = 100000;
let t0 = now();
const pp = pingpong();
let last = pp.next()!;
for (let i = 1; i <= PING_N; i = i + 1) {
    last = pp.next()!;
}
let t1 = now();
print(`pingpong checksum=${last} ms=${(t1 - t0)}`);

const MAP_N = 100000;
t0 = now();
let mapSum = 0;
let filtSum = 0;
const rg = rangeGen(0, MAP_N);
while(const v = rg.next()) {
    mapSum = mapSum + v * 2; if ((v % 2) == 0) {
        filtSum = filtSum + v;
    }
}
t1 = now();
print(`mapfilter map_sum=${mapSum} filt_sum=${filtSum} ms=${(t1 - t0)}`);

const FIB_N = 80;
t0 = now();
let fibCarry = 0;
const fg = fibGen();
for (let i = 0; i < FIB_N; i = i + 1) {
    fibCarry = fg.next()!;
}
t1 = now();
print(`fibcarry checksum=${fibCarry} ms=${(t1 - t0)}`);

t0 = now();
let nestSum = 0;
const no = nestedOuter();
while(const item = no.next()) {
    nestSum = nestSum + item;
}
t1 = now();
print(`nested checksum=${nestSum} ms=${(t1 - t0)}`);

t0 = now();
const counter = makeCounter(3);
const c1 = counter();
const c2 = counter();
const capSum = c1.next()! + c1.next()! + c2.next()!;
t1 = now();
print(`upvalue checksum=${capSum} ms=${(t1 - t0)}`);

t0 = now();
let trySum = 0;
try {
    const gg = guarded();
    trySum = trySum + gg.next()!;
    trySum = trySum + gg.next()!;
} catch {
    trySum = -1;
}
t1 = now();
print(`tryoutside checksum=${trySum} ms=${(t1 - t0)}`);
