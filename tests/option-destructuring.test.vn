import { describe, it, expect } from "std:test";

enum R {
    A(int),
    B(str)
}

await describe("29 Option Destructuring", async () => {
    await it("enum match", () => {
        const x = R.A(42);
        const v = match (x) {
            A(n) => n,
            B(_) => -1,
        };
        if(v != 42) {
            throw new Error(`DEBUG FAIL: v is not 42, it is: ${v}`);
        }
        expect(v).toBe(42);
        const y = R.B("boom");
        const v2 = match (y) {
            A(n) => n,
            B(_) => -1,
        };
        expect(v2).toBe(-1);
    });
});
