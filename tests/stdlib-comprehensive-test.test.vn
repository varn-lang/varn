import { describe, it, expect } from "std:test";
import { Duration, PlainDateTime, nowInstant } from 'std:time';
import { List, Stack, Queue } from 'std:collections';
import { fetch, HttpServer, Request, Response } from 'std:http';
import { Json, JsonValue } from 'std:encoding';
import { uuid, sha256 } from 'std:crypto';
import {
    writeText as fsWrite,
    exists as fsExists,
    readText as fsRead,
    tempDir as fsTempDir,
    remove as fsRemove,
} from 'std:fs';
import { write as ioWrite, writeln as ioWriteln } from 'std:io';
import { PI as mathPI, abs as mathAbs, min as mathMin, max as mathMax } from 'std:math';
import { platform as sysPlatform, cwd as sysCwd } from 'std:sys';
import { isIP as netIsIP, Url } from 'std:net';
import { Path } from 'std:path';
import { defineMetadata, getMetadata, hasMetadata, MetaKey } from 'std:reflect';
import { delay, TaskGroup, spawn, parallel } from 'std:task';

// Disposable, AsyncDisposable, Partial, Required, Readonly, Mutable, Record
// are now globally available (prelude) — no import needed.
// Option/Result are core types: in scope with no import.
class ResourceImpl implements Disposable {
    disposed: bool = false;
    dispose(): void {
        this.disposed = true;
    }
}

@capability("fs.read", "fs.write", "net.server", "net.client")
async function runComprehensiveTest(): Task<void> {
    // 1. std:time
    const d = Duration.from("PT1H30M");
    expect(d.hours).toBe(1);
    const dt = new PlainDateTime(2026, 4, 21, 10, 0, 0, 0);
    expect(dt.year).toBe(2026);
    const t1 = nowInstant();
    expect(t1.toString().length > 0).toBeTruthy();

    // 2. std:math
    expect(mathPI > 3.14 && mathPI < 3.15).toBeTruthy();
    expect(mathAbs(-10.5)).toBe(10.5);
    expect(mathMin(5.0, 3.0, 8.0)).toBe(3.0);
    expect(mathMax(5.0, 3.0, 8.0)).toBe(8.0);

    // 3. std:crypto
    const uuidVal = uuid();
    expect(uuidVal.length).toBe(36);
    const hash = sha256("Hello");
    expect(hash.length).toBe(64);

    // 4. std:json
    const serialized = Json.stringify(#{ test: "json", value: 123 });
    const parsed = Json.parse<Map<str, JsonValue >> (serialized);
    expect(parsed["test"]).toBe("json");
    expect(parsed["value"]).toBe(123);

    // 5. std:collections
    const list = new List<str>(["A"]);
    list.add("B");
    expect(list.toArray()[1]).toBe("B");

    const stack = new Stack<int>();
    stack.push(42);
    expect(stack.peek()).toBe(42);
    expect(stack.pop()).toBe(42);

    const queue = new Queue<str>();
    queue.enqueue("first");
    expect(queue.peek()).toBe("first");
    expect(queue.dequeue()).toBe("first");

    const mapInst = new Map<str, int>();
    mapInst.set("key", 100);
    expect(mapInst.has("key")).toBeTruthy();
    expect(mapInst.get("key")).toBe(100);

    const rangeObj = Range.from(1, 5);
    expect(rangeObj.start).toBe(1);
    expect(rangeObj.contains(3)).toBeTruthy();

    // 6. std:fs
    const testFile = Path.join(fsTempDir(), "varn-42-stdlib-fs.txt");
    fsWrite(testFile, "Varn File System Test");
    expect(fsExists(testFile)).toBeTruthy();
    const readContent = fsRead(testFile);
    expect(readContent).toBe("Varn File System Test");
    fsRemove(testFile);

    // 7. std:io
    ioWrite("");
    ioWriteln("");

    // 8. std:sys
    expect(sysPlatform().length > 0).toBeTruthy();
    expect(sysCwd().length > 0).toBeTruthy();

    // 9. std:net
    expect(netIsIP("127.0.0.1")).toBeTruthy();
    expect(!netIsIP("not-an-ip")).toBeTruthy();
    const urlObj = Url.parse("https://varn-lang.dev:8080/docs?q=1#main");
    expect(urlObj.protocol).toBe("https");
    expect(urlObj.host).toBe("varn-lang.dev");
    expect(urlObj.port).toBe(8080);
    expect(urlObj.path).toBe("/docs");
    expect(urlObj.query.get("q")).toBe("1");
    expect(urlObj.fragment).toBe("main");

    // 10. std:path
    const isWindows = sysPlatform() == "windows";
    const expectedNormalize = isWindows ? "a\\c" : "a/c";
    const expectedJoin = isWindows ? "a\\b\\c" : "a/b/c";
    expect(Path.normalize("a/b/../c")).toBe(expectedNormalize);
    expect(Path.dirname("a/b/c")).toBe("a/b");
    expect(Path.basename("a/b/file.txt")).toBe("file.txt");
    const extRes = Path.extname("file.txt");
    expect(extRes).toBe(".txt");
    expect(Path.join("a", "b", "c")).toBe(expectedJoin);

    // 11. std:reflect
    defineMetadata("my_key", "my_val", list);
    expect(getMetadata<str, str, List<str >> ("my_key", list)).toBe("my_val");
    expect(hasMetadata("my_key", list)).toBeTruthy();

    const _mkey = MetaKey.create<int[], str>();
    expect(getMetadata<str, str, List<str >> ("my_key", list)).toBe("my_val");
    expect(hasMetadata("my_key", list)).toBeTruthy();

    // 12. std:http
    const httpServer = new HttpServer();
    httpServer.get("/", async (_req: Request) => new Response("hello from 42", 200));
    httpServer.listen(0);
    await delay(150);
    const clientRes = await fetch(`http://127.0.0.1:${httpServer.port}/`);
    expect(clientRes.status).toBe(200);
    expect(clientRes.body).toBe("hello from 42");
    httpServer.close();

    // 13. std:task
    async function threeHundred(): Task<int> {
        return 100 + 200;
    }
    const h1 = spawn(threeHundred());
    const val = await h1;
    expect(val).toBe(300);

    async function one(): Task<int> {
        return 1;
    }
    async function two(): Task<int> {
        return 2;
    }
    const all = await parallel([one(), two()]);
    expect(all[0] == 1 && all[1] == 2).toBeTruthy();

    using group = new TaskGroup<int>();
    async function ten(): Task<int> {
        return 10;
    }
    async function twenty(): Task<int> {
        return 20;
    }
    const _g1 = group.spawn(ten());
    const _g2 = group.spawn(twenty());
    const joined = await group.join();
    expect(joined[0] == 10 && joined[1] == 20).toBeTruthy();

    // 14. std:dispose
    const dispObj = new ResourceImpl();
    {
        using r = dispObj;
        expect(dispObj.disposed).toBe(false);
    }
    expect(dispObj.disposed).toBe(true);

    // 15. null is the single absent value: `T?`, `??` and a binding condition.
    const optSome: int? = 99;
    const optNone: int? = null;
    expect(optSome != null).toBeTruthy();
    expect(optNone == null).toBeTruthy();
    expect(optSome!).toBe(99);
    expect(optSome ?? 50).toBe(99);
    expect(optNone ?? 50).toBe(50);
    if(const v = optSome) {
        expect(v).toBe(99);
    } else {
        expect(false).toBeTruthy();
    }

    // 16. std:result (Result)
    const resOk = Ok<str, int>("success");
    const resErr = Err<str, int>(500);
    match(resOk) {
        Ok(v) => expect(v).toBe("success"),
        Err(_) => expect(false).toBeTruthy(),
    }
    match(resErr) {
        Ok(_) => expect(false).toBeTruthy(),
        Err(e) => expect(e).toBe(500),
    }
    const resTry = Result.catching<int>(() => {
        return 888;
    });
    match(resTry) {
        Ok(v) => expect(v).toBe(888),
        Err(_) => expect(false).toBeTruthy(),
    }

    // 17. std:test
    expect(true).toBeTruthy();
    expect(true).toBeTruthy();
    expect(777).toBe(777);

    // 18. std:types
    const partialVar: #{ x?: int; y?: str } = #{ x: 42 };
    const readonlyVar: #{ readonly a: bool } = #{ a: true };
    const requiredVar: #{ x: int; y: str } = #{ x: 10, y: "yes" };
    const mutableVar: #{ a: bool } = #{ a: false };
    const recordVar = new Map([#["tested", 100]]);

    expect(partialVar.x).toBe(42);
    expect(readonlyVar.a).toBe(true);
    expect(requiredVar.x == 10 && requiredVar.y == "yes").toBeTruthy();
    expect(mutableVar.a).toBe(false);
    expect(recordVar["tested"]).toBe(100);
}
await describe("42 stdlib comprehensive test", async () => {
    await it("tests", async () => {
        await runComprehensiveTest()
    });
});
