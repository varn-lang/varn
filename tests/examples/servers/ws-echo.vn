import { WsServer } from "std:ws";

@capability("net.server")
async function main(): Task<void> {
    const srv = WsServer.listen(19884);
    const conn = await srv.accept();
    const msg = await conn.read();
    if(msg != null) {
        await conn.send("ECHO:" + (msg as Bytes).toString());
    }
    conn.close();
    srv.close();
}

await main();
