import { describe, it, expect } from "std:test";

interface Flagged { mut seen: bool?; mut mark: char? }
function readSeen(f: Flagged): bool? { return f.seen }
function writeMark(f: Flagged, c: char?): void { f.mark = c }

class Probe {
    seen: bool? = null;
    mark: char? = null;
    code: int = 0;
    constructor(code: int) { this.code = code }
}

function tally(ps: Probe[]): int {
    let t = 0
    for (const p of ps) {
        if (p.seen == true) { t = t + 1 }
        if (p.seen == false) { t = t + 10 }
        if (p.seen == null) { t = t + 100 }
        const m = p.mark
        if (m != null) { t = t + m.charCodeAt() }
    }
    return t
}

function probes(): Probe[] {
    const ps: Probe[] = []
    for (let i = 0; i < 600; i = i + 1) {
        const p = new Probe(i)
        if (i % 3 == 1) { p.seen = true }
        if (i % 3 == 2) { p.seen = false }
        if (i % 4 == 0) { p.mark = 'a' }
        if (i % 4 == 1) { p.mark = '😀' }
        ps.push(p)
    }
    return ps
}

await describe("357 nullable scalar fields", async () => {
    await it("a bool? and a char? field keep null apart from every value", async () => {
        const ps = probes()
        expect(tally(ps)).toBe(19315550)
        expect(ps[0].seen).toBe(null)
        expect(ps[1].seen).toBe(true)
        expect(ps[2].seen).toBe(false)
        expect(ps[0].mark).toBe('a')
        expect(ps[1].mark).toBe('😀')
        expect(ps[2].mark).toBe(null)
        ps[1].seen = null
        expect(ps[1].seen).toBe(null)
    });

    await it("the fields are read and written by name and copied with with", async () => {
        const ps = probes()
        let seenCount = 0
        for (let i = 0; i < 600; i = i + 1) { if (readSeen(ps[i]) == true) { seenCount = seenCount + 1 } }
        expect(seenCount).toBe(200)
        for (let i = 0; i < 600; i = i + 1) { writeMark(ps[i], i % 2 == 0 ? null : 'z') }
        expect(ps[0].mark).toBe(null)
        expect(ps[1].mark).toBe('z')
        const copy = ps[4] with { seen: false, mark: null }
        expect(copy.seen).toBe(false)
        expect(copy.mark).toBe(null)
        expect(ps[4].seen).toBe(true)
        expect(ps[4].code).toBe(4)
    });
});
