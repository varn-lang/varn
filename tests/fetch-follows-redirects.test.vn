import { describe, it, expect } from "std:test";
import { delay } from "std:task";
import { fetch, HttpServer, HttpMethod, Request, RequestInit, Response, redirect } from "std:http";

async function failureOf(run: () => Task<dynamic>): Task<str> {
    try {
        await run()
        return ""
    } catch (e) {
        return e.message
    }
}

await describe("294 fetch follows redirects", async () => {
    const origin = new HttpServer();
    const other = new HttpServer();

    origin.get("/start", async (_req: Request) => redirect("/two", 302));
    origin.get("/two", async (_req: Request) => new Response("arrived", 200));
    origin.get("/dir/start", async (_req: Request) => redirect("sub/page?x=1", 302));
    origin.get("/dir/sub/page", async (req: Request) =>
        new Response("relative " + (req.query["x"] ?? "none"), 200));
    origin.get("/up/start", async (_req: Request) => redirect("../two", 302));
    origin.post("/post-redirect", async (_req: Request) => redirect("/method", 302));
    origin.get("/method", async (req: Request) =>
        new Response(req.method == HttpMethod.GET ? "GET" : "other", 200));
    origin.post("/keep", async (_req: Request) => redirect("/echo-body", 307));
    origin.post("/echo-body", async (req: Request) => new Response("body=" + req.text(), 200));
    origin.get("/loop", async (_req: Request) => redirect("/loop", 302));
    origin.get("/to-other", async (_req: Request) =>
        redirect(`http://127.0.0.1:${other.port}/who`, 302));
    other.get("/who", async (req: Request) =>
        new Response("auth=" + (req.headers.get("authorization") ?? "none"), 200));
    origin.get("/who", async (req: Request) =>
        new Response("auth=" + (req.headers.get("authorization") ?? "none"), 200));
    origin.get("/same", async (_req: Request) => redirect("/who", 302));

    origin.listen(0);
    other.listen(0);
    await delay(150);

    await it("a 302 is followed and the final url is reported", async () => {
        const res = await fetch(`http://127.0.0.1:${origin.port}/start`);
        expect(res.status).toBe(200);
        expect(res.text()).toBe("arrived");
        expect(res.url).toBe(`http://127.0.0.1:${origin.port}/two`);
    });

    await it("relative locations resolve against the current path", async () => {
        const sibling = await fetch(`http://127.0.0.1:${origin.port}/dir/start`);
        expect(sibling.text()).toBe("relative 1");
        const parent = await fetch(`http://127.0.0.1:${origin.port}/up/start`);
        expect(parent.text()).toBe("arrived");
    });

    await it("a POST becomes a GET on 302 but keeps its method and body on 307", async () => {
        const turned = await fetch(
            `http://127.0.0.1:${origin.port}/post-redirect`,
            new RequestInit(method: HttpMethod.POST, body: "payload"),
        );
        expect(turned.text()).toBe("GET");
        const kept = await fetch(
            `http://127.0.0.1:${origin.port}/keep`,
            new RequestInit(method: HttpMethod.POST, body: "payload"),
        );
        expect(kept.text()).toBe("body=payload");
    });

    await it("credentials are sent to the same origin but dropped across origins", async () => {
        const headers = new Map<str, str>([#["Authorization", "Bearer secret"]]);
        const same = await fetch(
            `http://127.0.0.1:${origin.port}/same`,
            new RequestInit(headers: headers),
        );
        expect(same.text()).toBe("auth=Bearer secret");
        const cross = await fetch(
            `http://127.0.0.1:${origin.port}/to-other`,
            new RequestInit(headers: headers),
        );
        expect(cross.text()).toBe("auth=none");
    });

    await it("followRedirects: false returns the redirect itself", async () => {
        const res = await fetch(
            `http://127.0.0.1:${origin.port}/start`,
            new RequestInit(followRedirects: false),
        );
        expect(res.status).toBe(302);
        expect(res.headers.get("location")).toBe("/two");
    });

    await it("a redirect loop stops at the limit", async () => {
        const message = await failureOf(() =>
            fetch(`http://127.0.0.1:${origin.port}/loop`, new RequestInit(maxRedirects: 3)));
        expect(message.indexOf("more than 3 redirects") != null).toBeTruthy();
    });

    origin.close();
    other.close();
});
