import { TcpListener } from "std:net";
import { args } from "std:sys";
import { announcePort } from "./port_file.vn";

@capability("net.server", "fs.read", "fs.write")
async function main() {
    const argv = args();
    const listener = TcpListener.listen(0);
    announcePort(argv[argv.length - 1], listener.port);
    while(true) {
        const client = await listener.accept();
        const msg = await client.readText();
        await client.writeAll("ECHO:" + msg.trim() + "\n");
        client.close();
    }
}

await main();
