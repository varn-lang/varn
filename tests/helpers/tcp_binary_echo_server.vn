import { TcpListener } from "std:net";
import { args } from "std:sys";
import { announcePort } from "./port_file.vn";

@capability("net.server", "fs.read", "fs.write")
async function main() {
    const argv = args();
    let listener = TcpListener.listen(0);
    announcePort(argv[argv.length - 1], listener.port);
    let client = await listener.accept();
    let data = await client.read(1024);
    if(data != null) {
        let b = data as Bytes;
        await client.writeAll(b);
    }
    client.close();
    listener.close();
}

await main();
