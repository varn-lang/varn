import { describe, it, expect } from "std:test";
import { delay } from "std:task";

class Frame {
    consumed: int;
    constructor(consumed: int) {
        this.consumed = consumed
    }
}

function parse(buf: Bytes): Frame? {
    if(buf.length < 4) {
        return null
    }
    return new Frame(buf.length)
}

async function chunk(round: int): Task<Bytes?> {
    await delay(0);
    if(round > 6) {
        return null
    }
    return Bytes.alloc(2)
}

class Reader {
    buf: Bytes = Bytes.alloc(0);
    notified: int = 0;

    notify(): void {
        this.notified = this.notified + 1
    }

    async read(): Task<int> {
        let round = 0;
        while(true) {
            let frame: Frame? = null;
            try {
                frame = parse(this.buf);
            } catch(e) {
                throw e;
            }
            if(frame == null) {
                let more: Bytes?;
                try {
                    more = await chunk(round);
                } catch(e) {
                    this.notify();
                    throw e;
                }
                round = round + 1;
                if(more == null) {
                    return -1
                }
                this.buf = Bytes.alloc(this.buf.length + (more as Bytes).length);
                continue;
            }
            const parsed = frame as Frame;
            this.buf = this.buf.slice(parsed.consumed);
            return parsed.consumed;
        }
    }
}

function guarded(n: int): int {
    let sum = 0;
    for(let i = 0; i < n; i = i + 1) {
        try {
            if(i % 7 == 0) {
                throw new Error("seven")
            }
            sum = sum + i;
        } catch {
            sum = sum + 1000;
        }
    }
    return sum;
}

function afterTry(n: int): int {
    let caught = 0;
    for(let i = 0; i < n; i = i + 1) {
        try {
            caught = caught + 0;
        } catch {
            caught = caught + 100000;
        }
        try {
            if(i % 5 >= 3) {
                throw new Error("late")
            }
        } catch {
            caught = caught + 1;
        }
    }
    return caught;
}

await describe("jit try regions", async () => {
    await it("a try in a hot loop keeps its catch and its fall-through", async () => {
        let total = 0;
        for(let k = 0; k < 400; k = k + 1) {
            total = total + guarded(60)
        }
        expect(total).toBe(4207200);
    });

    await it("an error raised after a finished try is not routed to that try", async () => {
        let total = 0;
        for(let k = 0; k < 300; k = k + 1) {
            total = total + afterTry(10)
        }
        expect(total).toBe(300 * 4);
    });

    await it("two try regions with an await in the second keep their variables apart", async () => {
        const reader = new Reader();
        let sum = 0;
        for(let i = 0; i < 12; i = i + 1) {
            sum = sum + await reader.read()
        }
        expect(sum).toBe(48);
        expect(reader.notified).toBe(0);
    });
});
