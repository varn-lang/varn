import { describe, it, expect } from "std:test";
import { Ffi, FfiType } from "std:ffi";
import { platform } from "std:sys";

await describe("Extended FFI API", async () => {
    await it("Memory allocation and pointer integer read/write", () => {
        const ptr = Ffi.alloc(64);
        expect(ptr.isNull()).toBe(false);

        ptr.writeI8(42, 0);
        expect(ptr.readI8(0)).toBe(42);

        ptr.writeI16(1024, 2);
        expect(ptr.readI16(2)).toBe(1024);

        ptr.writeI32(70000, 4);
        expect(ptr.readI32(4)).toBe(70000);

        ptr.writeI64(9876543210, 8);
        expect(ptr.readI64(8)).toBe(9876543210);

        const off = ptr.offset(8);
        expect(off.readI64(0)).toBe(9876543210);

        ptr.free();
    });

    await it("Memory allocation and pointer float read/write", () => {
        const ptr = Ffi.alloc(32);
        ptr.writeF64(123.456, 0);
        const val = ptr.readF64(0);
        expect(val > 123.45 && val < 123.46).toBe(true);

        ptr.writeF32(50.5, 8);
        const f32Val = ptr.readF32(8);
        expect(f32Val > 50.49 && f32Val < 50.51).toBe(true);

        ptr.free();
    });

    await it("CString allocation, reading and freeing", () => {
        const text = "Varn Foreign Function Interface v2";
        const cstr = Ffi.cStr(text);
        expect(cstr.isNull()).toBe(false);

        const recovered = Ffi.readCString(cstr);
        expect(recovered).toBe(text);

        const recoveredDirect = cstr.readCString();
        expect(recoveredDirect).toBe(text);

        cstr.free();
    });

    await it("Dynamic library loading, binding and calling native functions", () => {
        const os = platform();
        const libName =
            os == "windows" ? "kernel32.dll" : os == "macos" ? "libSystem.B.dylib" : "libc.so.6";
        const fnName = os == "windows" ? "GetCurrentProcessId" : "getpid";

        const lib = Ffi.open(libName);
        const getPid = lib.bind(fnName, FfiType.Int, []);
        const pid = getPid.call() as int;
        expect(pid > 0).toBe(true);

        const closed = lib.close();
        expect(closed).toBe(true);
    });
});
