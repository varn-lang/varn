// runtime:ui — headless window/event/draw backend (v1, no winit).
// Single event queue + command log per window. Real backend feeds the same
// queue and draws instead of logging. Same API, no dual paths.

export declare enum UiEventKind {
    Key,
    Mouse,
    Resize,
    Close,
    Wheel
}

export declare enum UiControlKind {
    Button,
    Switch,
    Slider,
    Scroll,
    Surface,
    Field,
    Area
}

export declare enum UiInjectKind {
    Key,
    Mouse,
    MouseDown,
    MouseUp,
    Resize,
    Close,
    Wheel
}

export struct UiEvent {
    kind: UiEventKind;
    key: int;
    pressed: bool;
    x: int;
    y: int;
    button: int;
    w: int;
    h: int;
}


export declare function open$(title: str, w: int, h: int, headless: bool): int;
export declare function close$(id: int): void;
export declare function setDark$(id: int, dark: bool): void;
export declare function shouldClose$(id: int): bool;
export declare function size$(id: int): int[];
export declare function inject$(id: int, kind: UiInjectKind, a: int, b: int, c: int): void;
export declare function poll$(id: int): UiEvent[];
export declare function rect$(id: int, x: float, y: float, w: float, h: float, color: int, radius: float): void;
export declare function text$(id: int, x: float, y: float, s: str, size: float, color: int): void;
export declare function clip$(id: int, x: float, y: float, w: float, h: float): void;
export declare function unclip$(id: int): void;
export declare function clear$(id: int, color: int): void;
export declare function present$(id: int): int;
export declare function control$(window: int, cid: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, flag: bool, value: float, low: float, high: float): void;
export declare function activated$(id: int): float[];
export declare function drawn$(id: int): DrawnItem[];
export declare function real$(id: int): bool;
export declare function keyCode$(name: str): int;

export interface DrawnItem {
    kind: str;
    x: float;
    y: float;
    w: float;
    h: float;
    color: int;
    text: str;
}

export struct TypedText {
    id: int;
    text: str;
}


export declare function field$(window: int, cid: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, focused: bool, text: str, hint: str, size: float): void;
export declare function typed$(window: int): TypedText[];
export declare function textWidth$(window: int, text: str, size: float): float;
