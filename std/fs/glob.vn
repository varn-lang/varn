import { readDir$, stat$ } from "runtime:fs";
import { cwd } from "std:sys";
import { join } from "std:path";

function segMatch(seg: str, name: str): bool {
    if(name.startsWith(".") && !seg.startsWith(".")) {
        return false;
    }
    return matchFrom(seg, 0, name, 0);
}

function matchFrom(seg: str, si: int, name: str, ni: int): bool {
    while(si < seg.length) {
        const c = seg[si];
        if(c == "*") {
            let k = ni;
            while(k <= name.length) {
                if(matchFrom(seg, si + 1, name, k)) {
                    return true;
                }
                k = k + 1;
            }
            return false;
        }
        if(ni >= name.length) {
            return false;
        }
        if(c == "?") {
            si = si + 1;
            ni = ni + 1;
            continue;
        }
        if(c == "[") {
            const rel = seg.slice(si).indexOf("]");
            if(rel == null) {
                return false;
            }
            const close = si + rel;
            const set = seg.slice(si + 1, close);
            let hit = false;
            let j = 0;
            while(j < set.length) {
                if(j + 2 < set.length && set[j + 1] == "-") {
                    if(name[ni] >= set[j] && name[ni] <= set[j + 2]) {
                        hit = true;
                    }
                    j = j + 3;
                } else {
                    if(name[ni] == set[j]) {
                        hit = true;
                    }
                    j = j + 1;
                }
            }
            if(!hit) {
                return false;
            }
            si = close + 1;
            ni = ni + 1;
            continue;
        }
        if(c != name[ni]) {
            return false;
        }
        si = si + 1;
        ni = ni + 1;
    }
    return ni >= name.length;
}

@capability("fs.read")
function isDir(path: str): bool {
    try {
        return stat$(path).isDir;
    } catch {
        return false;
    }
}

@capability("fs.read")
function walk(dir: str, segs: str[], idx: int, out: str[]): void {
    if(idx >= segs.length) {
        out.push(dir);
        return;
    }
    const seg = segs[idx];
    if(seg == "**") {
        walk(dir, segs, idx + 1, out);
        let entries: str[];
        try {
            entries = readDir$(dir) as str[];
        } catch {
            return;
        }
        for(let entry in entries) {
            const full = join(dir, entry);
            if(isDir(full)) {
                walk(full, segs, idx, out);
            }
        }
        return;
    }
    let entries: str[];
    try {
        entries = readDir$(dir) as str[];
    } catch {
        return;
    }
    for(let entry in entries) {
        if(!segMatch(seg, entry)) {
            continue;
        }
        const full = join(dir, entry);
        if(idx == segs.length - 1) {
            out.push(full);
        } else if (isDir(full)) {
            walk(full, segs, idx + 1, out);
        }
    }
}

@capability("fs.read")
export function glob(pattern: str): str[] {
    const norm = pattern.replaceAll("\\", "/");
    let segs: str[] = [];
    for(let s in norm.split("/")) {
        if(s.length > 0) {
            segs.push(s);
        }
    }
    let base = "";
    if(norm.startsWith("/") || (norm.length >= 2 && norm[1] == ":")) {
        if(norm.length >= 2 && norm[1] == ":") {
            base = norm.slice(0, 3);
            if(segs.length > 0 && segs[0].length == 2 && segs[0][1] == ":") {
                segs = segs.slice(1);
            }
        } else {
            base = "/";
            if(segs.length == 0) {
                return ["/"];
            }
        }
    } else {
        base = cwd();
    }
    const out: str[] = [];
    walk(base, segs, 0, out);
    for(let i = 1; i < out.length; i = i + 1) {
        const key = out[i];
        let j = i - 1;
        while(j >= 0 && out[j].compare(key) > 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
    }
    return out;
}
