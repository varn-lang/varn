import {
    MarkdownOptions,
    MarkdownNode,
    MarkdownHeading,
    MarkdownLink,
    MarkdownNodeKind,
    TableAlign,
} from "std:markdown/ast";
import { escapeHtmlStr, slugify as slugifyUtil } from "std:markdown/utils";

function alignAttribute(align: TableAlign): str {
    return match (align) {
        None => "",
        Left => " align=\"left\"",
        Center => " align=\"center\"",
        Right => " align=\"right\""
    };
}

export function renderAst(node: MarkdownNode, options?: MarkdownOptions): str {
    const optXhtml = options?.xhtml ?? false;
    const optEscape = options?.escapeHtml ?? true;
    const optBreaks = options?.breaks ?? false;

    const brTag = optXhtml ? "<br />" : "<br>";
    const hrTag = optXhtml ? "<hr />\n" : "<hr>\n";

    if(node.kind == MarkdownNodeKind.Root) {
        let out = "";
        for(let child in node.children) {
            out = out + renderAst(child, options);
        }
        return out;
    }

    if(node.kind == MarkdownNodeKind.Heading) {
        const tag = `h${node.level}`;
        let inner = "";
        for(let c in node.children) {
            inner = inner + renderAst(c, options);
        }
        return "<" + tag + ">" + inner + "</" + tag + ">\n";
    }

    if(node.kind == MarkdownNodeKind.Paragraph) {
        let inner = "";
        for(let c in node.children) {
            inner = inner + renderAst(c, options);
        }
        if(optBreaks) {
            inner = inner.replaceAll("\n", brTag + "\n");
        }
        return "<p>" + inner + "</p>\n";
    }

    if(node.kind == MarkdownNodeKind.CodeBlock) {
        const code = optEscape ? escapeHtmlStr(node.text) : node.text;
        if(node.lang.length > 0) {
            return "<pre><code class=\"language-" +
                escapeHtmlStr(node.lang) +
                "\">" +
                code +
                "\n</code></pre>\n";
        }
        return "<pre><code>" + code + "\n</code></pre>\n";
    }

    if(node.kind == MarkdownNodeKind.Blockquote) {
        let inner = "";
        for(let c in node.children) {
            inner = inner + renderAst(c, options);
        }
        return "<blockquote>\n" + inner + "</blockquote>\n";
    }

    if(node.kind == MarkdownNodeKind.List) {
        const tag = node.ordered ? "ol" : "ul";
        const startAttr = (node.ordered && node.start != 1) ? (` start="${node.start}"`) : "";
        let inner = "";
        for(let c in node.children) {
            inner = inner + renderAst(c, options);
        }
        return "<" + tag + startAttr + ">\n" + inner + "</" + tag + ">\n";
    }

    if(node.kind == MarkdownNodeKind.ListItem) {
        let inner = "";
        if(node.checked != null) {
            const chk = node.checked == true ? " checked=\"\"" : "";
            const inputTag =
                optXhtml
                    ? ("<input type=\"checkbox\"" + chk + " disabled=\"\" /> ")
                    : ("<input type=\"checkbox\"" + chk + " disabled> ");
            inner = inputTag;
        }
        for(let c in node.children) {
            inner = inner + renderAst(c, options);
        }
        return "<li>" + inner + "</li>\n";
    }

    if(node.kind == MarkdownNodeKind.Table) {
        const headRow = node.children.length > 0 ? node.children[0] : null;
        let thead = "";
        if(headRow != null) {
            let ths = "";
            for(let i = 0; i < headRow.children.length; i = i + 1) {
                const cell = headRow.children[i];
                const alignAttr = i < node.align.length ? alignAttribute(node.align[i]) : "";
                let cellContent = "";
                for(let c in cell.children) cellContent = cellContent + renderAst(c, options);
                ths = ths + "<th" + alignAttr + ">" + cellContent + "</th>";
            }
            thead = "<thead>\n<tr>" + ths + "</tr>\n</thead>\n";
        }

        let tbodyRows = "";
        for(let r = 1; r < node.children.length; r = r + 1) {
            const row = node.children[r];
            let tds = "";
            for(let i = 0; i < row.children.length; i = i + 1) {
                const cell = row.children[i];
                const alignAttr = i < node.align.length ? alignAttribute(node.align[i]) : "";
                let cellContent = "";
                for(let c in cell.children) cellContent = cellContent + renderAst(c, options);
                tds = tds + "<td" + alignAttr + ">" + cellContent + "</td>";
            }
            tbodyRows = tbodyRows + "<tr>" + tds + "</tr>\n";
        }
        const tbody = tbodyRows.length > 0 ? ("<tbody>\n" + tbodyRows + "</tbody>\n") : "";

        return "<table>\n" + thead + tbody + "</table>\n";
    }

    if(node.kind == MarkdownNodeKind.ThematicBreak) {
        return hrTag;
    }

    if(node.kind == MarkdownNodeKind.Text) {
        return optEscape ? escapeHtmlStr(node.text) : node.text;
    }

    if(node.kind == MarkdownNodeKind.InlineCode) {
        const code = optEscape ? escapeHtmlStr(node.text) : node.text;
        return "<code>" + code + "</code>";
    }

    if(node.kind == MarkdownNodeKind.Bold) {
        let inner = "";
        for(let c in node.children) inner = inner + renderAst(c, options);
        return "<strong>" + inner + "</strong>";
    }

    if(node.kind == MarkdownNodeKind.Italic) {
        let inner = "";
        for(let c in node.children) inner = inner + renderAst(c, options);
        return "<em>" + inner + "</em>";
    }

    if(node.kind == MarkdownNodeKind.Strikethrough) {
        let inner = "";
        for(let c in node.children) inner = inner + renderAst(c, options);
        return "<del>" + inner + "</del>";
    }

    if(node.kind == MarkdownNodeKind.Link) {
        let inner = "";
        for(let c in node.children) inner = inner + renderAst(c, options);
        const titleAttr =
            node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
        return "<a href=\"" + escapeHtmlStr(node.url) + "\"" + titleAttr + ">" + inner + "</a>";
    }

    if(node.kind == MarkdownNodeKind.Image) {
        const titleAttr =
            node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
        const altAttr = " alt=\"" + escapeHtmlStr(node.text) + "\"";
        const srcAttr = " src=\"" + escapeHtmlStr(node.url) + "\"";
        if(optXhtml) {
            return "<img" + srcAttr + altAttr + titleAttr + " />";
        }
        return "<img" + srcAttr + altAttr + titleAttr + ">";
    }

    return "";
}

export function toPlainText(ast: MarkdownNode): str {
    const out: str[] = [];

    function walk(n: MarkdownNode): void {
        if(n.kind == MarkdownNodeKind.Text || n.kind == MarkdownNodeKind.InlineCode) {
            out.push(n.text);
        } else if (n.kind == MarkdownNodeKind.CodeBlock) {
            out.push(n.text + "\n");
        } else {
            for(let c in n.children) {
                walk(c);
            }
            if(
                n.kind == MarkdownNodeKind.Paragraph ||
                    n.kind == MarkdownNodeKind.Heading ||
                    n.kind == MarkdownNodeKind.ListItem ||
                    n.kind == MarkdownNodeKind.ThematicBreak
            ) {
                out.push("\n");
            }
        }
    }

    walk(ast);
    return out.join("").trim();
}

export function extractHeadings(ast: MarkdownNode): MarkdownHeading[] {
    const list: MarkdownHeading[] = [];

    function walk(n: MarkdownNode): void {
        if(n.kind == MarkdownNodeKind.Heading) {
            list.push(new MarkdownHeading(level: n.level, text: n.text, id: slugifyUtil(n.text)));
        }
        for(let c in n.children) {
            walk(c);
        }
    }

    walk(ast);
    return list;
}

export function extractLinks(ast: MarkdownNode): MarkdownLink[] {
    const links: MarkdownLink[] = [];

    function walk(n: MarkdownNode): void {
        if(n.kind == MarkdownNodeKind.Link) {
            links.push(new MarkdownLink(text: n.text, url: n.url, title: n.title, isImage: false));
        } else if (n.kind == MarkdownNodeKind.Image) {
            links.push(new MarkdownLink(text: n.text, url: n.url, title: n.title, isImage: true));
        }
        for(let c in n.children) {
            walk(c);
        }
    }

    walk(ast);
    return links;
}
