export {
    MarkdownOptions,
    MarkdownHeading,
    MarkdownLink,
    MarkdownNode,
    MarkdownNodeKind,
    TableAlign,
} from "std:markdown/ast";

export {
    escapeHtmlStr,
    isWhitespaceChar,
    findFrom,
    startsWithAt,
    slugify,
} from "std:markdown/utils";

export {
    isThematicBreak,
    isHeadingLine,
    isListItemLine,
    isTableSeparator,
    parseTableAlignments,
    splitTableRow,
    parseInlineTokens,
    isParagraphEnd,
} from "std:markdown/parser";

export {
    renderAst,
    toPlainText,
    extractHeadings,
    extractLinks,
} from "std:markdown/renderer";

import {
    MarkdownOptions,
    MarkdownNode,
    MarkdownHeading,
    MarkdownLink,
    MarkdownNodeKind,
} from "std:markdown/ast";
import { escapeHtmlStr, isWhitespaceChar, slugify as slugifyUtil } from "std:markdown/utils";
import {
    isThematicBreak,
    isHeadingLine,
    isListItemLine,
    isTableSeparator,
    parseTableAlignments,
    splitTableRow,
    parseInlineTokens,
    isParagraphEnd,
} from "std:markdown/parser";
import {
    renderAst as renderAstImpl,
    toPlainText as toPlainTextImpl,
    extractHeadings as extractHeadingsImpl,
    extractLinks as extractLinksImpl,
} from "std:markdown/renderer";

export namespace Markdown {
    export function slugify(text: str): str {
        return slugifyUtil(text);
    }

    export function parse(source: str, options?: MarkdownOptions): MarkdownNode {
        const optGfm = options?.gfm ?? true;
        const optEscape = options?.escapeHtml ?? true;

        const root = new MarkdownNode(MarkdownNodeKind.Root);
        const rawLines = source.split("\n");
        const lines: str[] = [];
        for(let l in rawLines) {
            if(l.endsWith("\r")) {
                lines.push(l.slice(0, l.length - 1));
            } else {
                lines.push(l);
            }
        }

        let idx = 0;
        const total = lines.length;

        while(idx < total) {
            const line = lines[idx];
            const trimmed = line.trim();

            if(trimmed.length == 0) {
                idx = idx + 1;
                continue;
            }

            if(trimmed.startsWith("```") || trimmed.startsWith("~~~")) {
                const fenceChar = trimmed.slice(0, 3);
                const lang = trimmed.slice(3).trim();
                idx = idx + 1;
                const codeLines: str[] = [];
                while(idx < total) {
                    const curLine = lines[idx];
                    if(curLine.trim().startsWith(fenceChar)) {
                        idx = idx + 1;
                        break;
                    }
                    codeLines.push(curLine);
                    idx = idx + 1;
                }
                const codeNode = new MarkdownNode(MarkdownNodeKind.CodeBlock, codeLines.join("\n"));
                codeNode.lang = lang;
                root.addChild(codeNode);
                continue;
            }

            if(line.startsWith("    ") || line.startsWith("\t")) {
                const codeLines: str[] = [];
                while(idx < total) {
                    const curLine = lines[idx];
                    if(curLine.trim().length == 0) {
                        codeLines.push("");
                        idx = idx + 1;
                        continue;
                    }
                    if(curLine.startsWith("    ")) {
                        codeLines.push(curLine.slice(4));
                        idx = idx + 1;
                    } else if (curLine.startsWith("\t")) {
                        codeLines.push(curLine.slice(1));
                        idx = idx + 1;
                    } else {
                        break;
                    }
                }
                const codeNode = new MarkdownNode(MarkdownNodeKind.CodeBlock, codeLines.join("\n"));
                root.addChild(codeNode);
                continue;
            }

            const headingLevel = isHeadingLine(line);
            if(headingLevel > 0) {
                const trimmedStart = line.trimStart();
                let headingText = trimmedStart.slice(headingLevel).trim();
                if(headingText.endsWith("#")) {
                    let endIdx = headingText.length - 1;
                    while(endIdx >= 0 && headingText[endIdx] == "#") {
                        endIdx = endIdx - 1;
                    }
                    headingText = headingText.slice(0, endIdx + 1).trim();
                }
                const headingNode = new MarkdownNode(MarkdownNodeKind.Heading, headingText);
                headingNode.level = headingLevel;
                const inlines = parseInlineTokens(headingText, optEscape);
                for(let c in inlines) {
                    headingNode.addChild(c);
                }
                root.addChild(headingNode);
                idx = idx + 1;
                continue;
            }

            if(isThematicBreak(line)) {
                root.addChild(new MarkdownNode(MarkdownNodeKind.ThematicBreak));
                idx = idx + 1;
                continue;
            }

            if(trimmed.startsWith(">")) {
                const quoteLines: str[] = [];
                while(idx < total) {
                    const cur = lines[idx];
                    const curTrim = cur.trim();
                    if(curTrim.length == 0) {
                        break;
                    }
                    if(curTrim.startsWith(">")) {
                        const content = curTrim.slice(1).trimStart();
                        quoteLines.push(content);
                    } else {
                        quoteLines.push(cur);
                    }
                    idx = idx + 1;
                }
                const quoteContent = quoteLines.join("\n");
                const blockNode = new MarkdownNode(MarkdownNodeKind.Blockquote);
                const innerAst = parse(quoteContent, options);
                for(let c in innerAst.children) {
                    blockNode.addChild(c);
                }
                root.addChild(blockNode);
                continue;
            }

            if(optGfm && idx + 1 < total && isTableSeparator(lines[idx + 1])) {
                const headerRow = splitTableRow(lines[idx]);
                const alignments = parseTableAlignments(lines[idx + 1]);
                const tableNode = new MarkdownNode(MarkdownNodeKind.Table);
                tableNode.align = alignments;

                const headRowNode = new MarkdownNode(MarkdownNodeKind.TableRow);
                for(let cell in headerRow) {
                    const cellNode = new MarkdownNode(MarkdownNodeKind.TableCell, cell);
                    const inlines = parseInlineTokens(cell, optEscape);
                    for(let c in inlines) {
                        cellNode.addChild(c);
                    }
                    headRowNode.addChild(cellNode);
                }
                tableNode.addChild(headRowNode);
                idx = idx + 2;

                while(idx < total) {
                    const cur = lines[idx];
                    if(cur.trim().length == 0 || !cur.includes("|")) {
                        break;
                    }
                    const rowCells = splitTableRow(cur);
                    const rowNode = new MarkdownNode(MarkdownNodeKind.TableRow);
                    for(let cell in rowCells) {
                        const cellNode = new MarkdownNode(MarkdownNodeKind.TableCell, cell);
                        const inlines = parseInlineTokens(cell, optEscape);
                        for(let c in inlines) {
                            cellNode.addChild(c);
                        }
                        rowNode.addChild(cellNode);
                    }
                    tableNode.addChild(rowNode);
                    idx = idx + 1;
                }

                root.addChild(tableNode);
                continue;
            }

            if(isListItemLine(line)) {
                let isOrdered = false;
                let listStart = 1;
                const firstTrimmed = line.trimStart();
                if(
                    !firstTrimmed.startsWith("- ") &&
                        !firstTrimmed.startsWith("* ") &&
                        !firstTrimmed.startsWith("+ ")
                ) {
                    isOrdered = true;
                    let dotIdx = firstTrimmed.indexOf(".");
                    if(dotIdx == null) dotIdx = firstTrimmed.indexOf(")");
                    if(dotIdx != null) {
                        const di = dotIdx as int;
                        if(di > 0) {
                            listStart = firstTrimmed.slice(0, di).toInt();
                        }
                    }
                }

                const listNode = new MarkdownNode(MarkdownNodeKind.List);
                listNode.ordered = isOrdered;
                listNode.start = listStart;

                while(idx < total) {
                    const cur = lines[idx];
                    if(cur.trim().length == 0) {
                        idx = idx + 1;
                        let shouldCont = false;
                        if(idx < total) {
                            if(isListItemLine(lines[idx])) {
                                shouldCont = true;
                            }
                        }
                        if(shouldCont) {
                            continue;
                        }
                        break;
                    }
                    if(!isListItemLine(cur)) {
                        break;
                    }

                    const curTrimmed = cur.trimStart();
                    let content = "";
                    if(
                        curTrimmed.startsWith("- ") ||
                            curTrimmed.startsWith("* ") ||
                            curTrimmed.startsWith("+ ")
                    ) {
                        content = curTrimmed.slice(2);
                    } else {
                        const spaceIdx = curTrimmed.indexOf(" ");
                        if(spaceIdx != null) {
                            const si = spaceIdx as int;
                            if(si > 0) {
                                content = curTrimmed.slice(si + 1);
                            } else {
                                content = curTrimmed;
                            }
                        } else {
                            content = curTrimmed;
                        }
                    }

                    const itemNode = new MarkdownNode(MarkdownNodeKind.ListItem);
                    if(
                        optGfm &&
                            (
                                content.startsWith("[ ] ") ||
                                    content.startsWith("[x] ") ||
                                    content.startsWith("[X] ")
                            )
                    ) {
                        const isChecked = content.startsWith("[x] ") || content.startsWith("[X] ");
                        itemNode.checked = isChecked;
                        content = content.slice(4);
                    }

                    itemNode.text = content;
                    const inlines = parseInlineTokens(content, optEscape);
                    for(let c in inlines) {
                        itemNode.addChild(c);
                    }
                    listNode.addChild(itemNode);
                    idx = idx + 1;
                }

                root.addChild(listNode);
                continue;
            }

            const pLines: str[] = [];
            while(idx < total) {
                const cur = lines[idx];
                const curTrim = cur.trim();
                if(curTrim.length == 0) {
                    break;
                }
                if(isParagraphEnd(cur, curTrim)) {
                    break;
                }
                pLines.push(cur);
                idx = idx + 1;
            }

            const pText = pLines.join("\n");
            const pNode = new MarkdownNode(MarkdownNodeKind.Paragraph, pText);
            const inlines = parseInlineTokens(pText, optEscape);
            for(let c in inlines) {
                pNode.addChild(c);
            }
            root.addChild(pNode);
        }

        return root;
    }

    export function renderAst(node: MarkdownNode, options?: MarkdownOptions): str {
        return renderAstImpl(node, options);
    }

    export function render(source: str, options?: MarkdownOptions): str {
        const ast = parse(source, options);
        return renderAstImpl(ast, options);
    }

    export function toPlainText(source: str): str {
        const ast = parse(source, new MarkdownOptions(escapeHtml: false));
        return toPlainTextImpl(ast);
    }

    export function extractHeadings(source: str): MarkdownHeading[] {
        const ast = parse(source);
        return extractHeadingsImpl(ast);
    }

    export function extractLinks(source: str): MarkdownLink[] {
        const ast = parse(source);
        return extractLinksImpl(ast);
    }
}
