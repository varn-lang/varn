import { MarkdownNode, MarkdownNodeKind } from "std:markdown/ast";
import { findFrom, startsWithAt } from "std:markdown/utils";

export function parseInlineTokens(text: str, escapeHtml: bool): MarkdownNode[] {
    const nodes: MarkdownNode[] = [];
    let i = 0;
    let buf = "";

    function flushBuf(): void {
        if(buf.length > 0) {
            nodes.push(new MarkdownNode(MarkdownNodeKind.Text, buf));
            buf = "";
        }
    }

    while(i < text.length) {
        if(text[i] == "\\" && i + 1 < text.length) {
            buf = buf + text[i + 1];
            i = i + 2;
            continue;
        }

        if(text[i] == "`") {
            const endBacktick = findFrom(text, "`", i + 1);
            if(endBacktick != -1) {
                flushBuf();
                const codeContent = text.slice(i + 1, endBacktick);
                nodes.push(new MarkdownNode(MarkdownNodeKind.InlineCode, codeContent));
                i = endBacktick + 1;
                continue;
            }
        }

        if(startsWithAt(text, "![", i)) {
            const closeBracket = findFrom(text, "]", i + 2);
            if(closeBracket != -1 && startsWithAt(text, "(", closeBracket + 1)) {
                const closeParen = findFrom(text, ")", closeBracket + 2);
                if(closeParen != -1) {
                    flushBuf();
                    const altText = text.slice(i + 2, closeBracket);
                    const urlAndTitle = text.slice(closeBracket + 2, closeParen).trim();
                    let url = urlAndTitle;
                    let title = "";
                    const quoteIdx = urlAndTitle.indexOf("\"");
                    if(quoteIdx != null) {
                        const qi = quoteIdx as int;
                        url = urlAndTitle.slice(0, qi).trim();
                        const endQuote = urlAndTitle.lastIndexOf("\"");
                        if(endQuote != null) {
                            const eq2 = endQuote as int;
                            if(eq2 > qi) {
                                title = urlAndTitle.slice(qi + 1, eq2);
                            }
                        }
                    }
                    const imgNode = new MarkdownNode(MarkdownNodeKind.Image, altText);
                    imgNode.url = url;
                    imgNode.title = title;
                    nodes.push(imgNode);
                    i = closeParen + 1;
                    continue;
                }
            }
        }

        if(text[i] == "[") {
            const closeBracket = findFrom(text, "]", i + 1);
            if(closeBracket != -1 && startsWithAt(text, "(", closeBracket + 1)) {
                const closeParen = findFrom(text, ")", closeBracket + 2);
                if(closeParen != -1) {
                    flushBuf();
                    const linkText = text.slice(i + 1, closeBracket);
                    const urlAndTitle = text.slice(closeBracket + 2, closeParen).trim();
                    let url = urlAndTitle;
                    let title = "";
                    const quoteIdx = urlAndTitle.indexOf("\"");
                    if(quoteIdx != null) {
                        const qi = quoteIdx as int;
                        url = urlAndTitle.slice(0, qi).trim();
                        const endQuote = urlAndTitle.lastIndexOf("\"");
                        if(endQuote != null) {
                            const eq2 = endQuote as int;
                            if(eq2 > qi) {
                                title = urlAndTitle.slice(qi + 1, eq2);
                            }
                        }
                    }
                    const linkNode = new MarkdownNode(MarkdownNodeKind.Link, linkText);
                    linkNode.url = url;
                    linkNode.title = title;
                    const innerTokens = parseInlineTokens(linkText, escapeHtml);
                    for(let c in innerTokens) {
                        linkNode.addChild(c);
                    }
                    nodes.push(linkNode);
                    i = closeParen + 1;
                    continue;
                }
            }
        }

        if(text[i] == "<") {
            const closeAngle = findFrom(text, ">", i + 1);
            if(closeAngle != -1) {
                const linkContent = text.slice(i + 1, closeAngle);
                if(
                    linkContent.startsWith("http://") ||
                        linkContent.startsWith("https://") ||
                        linkContent.startsWith("mailto:")
                ) {
                    flushBuf();
                    const linkNode = new MarkdownNode(MarkdownNodeKind.Link, linkContent);
                    linkNode.url = linkContent;
                    linkNode.addChild(new MarkdownNode(MarkdownNodeKind.Text, linkContent));
                    nodes.push(linkNode);
                    i = closeAngle + 1;
                    continue;
                }
            }
        }

        if(startsWithAt(text, "~~", i)) {
            const endStrike = findFrom(text, "~~", i + 2);
            if(endStrike != -1) {
                flushBuf();
                const strikeContent = text.slice(i + 2, endStrike);
                const strikeNode = new MarkdownNode(MarkdownNodeKind.Strikethrough);
                const inner = parseInlineTokens(strikeContent, escapeHtml);
                for(let c in inner) {
                    strikeNode.addChild(c);
                }
                nodes.push(strikeNode);
                i = endStrike + 2;
                continue;
            }
        }

        if(startsWithAt(text, "***", i) || startsWithAt(text, "___", i)) {
            const marker = text.slice(i, i + 3);
            const endIdx = findFrom(text, marker, i + 3);
            if(endIdx != -1) {
                flushBuf();
                const content = text.slice(i + 3, endIdx);
                const boldNode = new MarkdownNode(MarkdownNodeKind.Bold);
                const italicNode = new MarkdownNode(MarkdownNodeKind.Italic);
                const inner = parseInlineTokens(content, escapeHtml);
                for(let c in inner) {
                    italicNode.addChild(c);
                }
                boldNode.addChild(italicNode);
                nodes.push(boldNode);
                i = endIdx + 3;
                continue;
            }
        }

        if(startsWithAt(text, "**", i) || startsWithAt(text, "__", i)) {
            const marker = text.slice(i, i + 2);
            const endIdx = findFrom(text, marker, i + 2);
            if(endIdx != -1) {
                flushBuf();
                const content = text.slice(i + 2, endIdx);
                const boldNode = new MarkdownNode(MarkdownNodeKind.Bold);
                const inner = parseInlineTokens(content, escapeHtml);
                for(let c in inner) {
                    boldNode.addChild(c);
                }
                nodes.push(boldNode);
                i = endIdx + 2;
                continue;
            }
        }

        if(text[i] == "*" || text[i] == "_") {
            const marker = text[i];
            const endIdx = findFrom(text, marker, i + 1);
            if(endIdx != -1 && endIdx > i + 1) {
                flushBuf();
                const content = text.slice(i + 1, endIdx);
                const italicNode = new MarkdownNode(MarkdownNodeKind.Italic);
                const inner = parseInlineTokens(content, escapeHtml);
                for(let c in inner) {
                    italicNode.addChild(c);
                }
                nodes.push(italicNode);
                i = endIdx + 1;
                continue;
            }
        }

        buf = buf + text[i];
        i = i + 1;
    }

    flushBuf();
    return nodes;
}
