import {
    open$,
    close$,
    setDark$,
    shouldClose$,
    size$,
    inject$,
    poll$,
    rect$,
    text$,
    clear$,
    clip$,
    unclip$,
    control$,
    field$,
    typed$,
    activated$,
    drawn$,
    textWidth$,
    real$,
    UiEvent,
    UiEventKind,
    UiInjectKind,
    UiControlKind,
    TypedText,
    DrawnItem
} from "runtime:ui";

export { UiEvent, UiEventKind, UiInjectKind, UiControlKind, TypedText, DrawnItem };

export class UiWindow {
    id: int;

    constructor(id: int) {
        this.id = id;
    }

    @capability("ui")
    static open(title: str, w: int, h: int, headless: bool = true): UiWindow {
        return new UiWindow(open$(title, w, h, headless));
    }

    @capability("ui")
    close(): void {
        close$(this.id);
    }

    setDark(dark: bool): void {
        setDark$(this.id, dark);
    }

    @capability("ui")
    dispose(): void {
        close$(this.id);
    }

    @capability("ui")
    shouldClose(): bool {
        return shouldClose$(this.id);
    }

    @capability("ui")
    size(): int[] {
        return size$(this.id);
    }

    @capability("ui")
    inject(kind: UiInjectKind, a: int, b: int, c: int): void {
        inject$(this.id, kind, a, b, c);
    }

    @capability("ui")
    poll(): UiEvent[] {
        return poll$(this.id);
    }

    @capability("ui")
    rect(x: float, y: float, w: float, h: float, color: int, radius: float = 0.0): void {
        rect$(this.id, x, y, w, h, color, radius);
    }

    @capability("ui")
    text(x: float, y: float, s: str, size: float, color: int): void {
        text$(this.id, x, y, s, size, color);
    }

    @capability("ui")
    clip(x: float, y: float, w: float, h: float): void {
        clip$(this.id, x, y, w, h);
    }

    @capability("ui")
    unclip(): void {
        unclip$(this.id);
    }

    @capability("ui")
    clear(color: int): void {
        clear$(this.id, color);
    }

    @capability("ui")
    control(cid: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, flag: bool, value: float, low: float, high: float): void {
        control$(this.id, cid, kind, x, y, w, h, color, flag, value, low, high);
    }

    @capability("ui")
    field(cid: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, focused: bool, text: str, hint: str, size: float): void {
        field$(this.id, cid, kind, x, y, w, h, color, focused, text, hint, size);
    }

    @capability("ui")
    typed(): TypedText[] {
        return typed$(this.id);
    }

    @capability("ui")
    activated(): float[] {
        return activated$(this.id);
    }

    @capability("ui")
    real(): bool {
        return real$(this.id);
    }

    @capability("ui")
    textWidth(text: str, size: float): float {
        return textWidth$(this.id, text, size);
    }

    @capability("ui")
    drawn(): DrawnItem[] {
        return drawn$(this.id);
    }
}
