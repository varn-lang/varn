import { hmacBytes$ } from "runtime:crypto";
import { Base64, Json, JsonValue } from "std:encoding";
import { timingSafeEqual } from "std:crypto/password";

function macName(algo: str): str {
    if(algo == "HS256") {
        return "sha256";
    }
    if(algo == "HS512") {
        return "sha512";
    }
    throw new RangeError("Jwt: unsupported algorithm '" + algo + "'");
}

export namespace Jwt {
    export function sign(payload: JsonValue, secret: str, algo: str = "HS256"): str {
        const hdr = Base64.encodeUrlBytes(
            Bytes.fromString(Json.stringify(#{ alg: algo, typ: "JWT" })),
        );
        const body = Base64.encodeUrlBytes(Bytes.fromString(Json.stringify(payload)));
        const input = hdr + "." + body;
        const sig = Base64.encodeUrlBytes(hmacBytes$(macName(algo), secret, input));
        return input + "." + sig;
    }

    export function decode(token: str): JsonValue? {
        const parts = token.split(".");
        if(parts.length != 3) {
            return null;
        }
        try {
            return Json.parse(Base64.decodeUrlBytes(parts[1]).toString());
        } catch {
            return null;
        }
    }

    export function verify(token: str, secret: str, algo: str = "HS256"): JsonValue? {
        const parts = token.split(".");
        if(parts.length != 3) {
            return null;
        }
        const input = parts[0] + "." + parts[1];
        const expected = Base64.encodeUrlBytes(hmacBytes$(macName(algo), secret, input));
        if(!timingSafeEqual(expected, parts[2])) {
            return null;
        }
        try {
            const header = Json.parse(
                Base64.decodeUrlBytes(parts[0]).toString(),
            ) as Map<str, JsonValue>;
            const algorithm = header.get("alg");
            if(!(algorithm is str)) {
                return null;
            }
            const alg = algorithm as str;
            if(alg != algo) {
                return null;
            }
            return Json.parse(Base64.decodeUrlBytes(parts[1]).toString());
        } catch {
            return null;
        }
    }
}
