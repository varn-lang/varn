import {
    nowMs$,
    parseIsoDuration$,
    parseIsoInstant$,
    msToParts$,
    partsToMs$,
    TimeParts,
} from "runtime:time";

export { TimeParts };

export struct DurationParts {
    years: int? = null;
    months: int? = null;
    days: int? = null;
    hours: int? = null;
    minutes: int? = null;
    seconds: int? = null;
    milliseconds: int? = null;
    sign: int? = null;
}

export function pad2(n: int): str {
    if(n < 10) return `0${n}`;
    return `${n}`;
}

export function pad3(n: int): str {
    if(n < 10) return `00${n}`;
    if(n < 100) return `0${n}`;
    return `${n}`;
}

export function pad4(n: int): str {
    if(n < 10) return `000${n}`;
    if(n < 100) return `00${n}`;
    if(n < 1000) return `0${n}`;
    return `${n}`;
}

export function isoYear(year: int): str {
    if(year >= 0 && year <= 9999) return pad4(year);
    const magnitude = year < 0 ? -year : year;
    const digits = `${magnitude}`;
    const padded = "0".repeat(6 - digits.length) + digits;
    return(year < 0 ? "-" : "+") + padded;
}

export function now(): int {
    return nowMs$();
}

export function toISOString(ms: int): str {
    const parts = msToParts$(ms);
    return isoYear(parts.year) +
        "-" +
        pad2(parts.month) +
        "-" +
        pad2(parts.day) +
        "T" +
        pad2(parts.hour) +
        ":" +
        pad2(parts.minute) +
        ":" +
        pad2(parts.second) +
        "." +
        pad3(parts.millisecond) +
        "Z";
}

export function fromISO(iso: str): int {
    return parseIsoInstant$(iso);
}

export function toParts(ms: int): TimeParts {
    return msToParts$(ms);
}

export function fromParts(parts: TimeParts): int {
    return partsToMs$(parts);
}

export function durationFromString(s: str): int {
    return parseIsoDuration$(s);
}

export function durationToString(ms: int): str {
    return `Duration(${ms}ms)`;
}

export function durationParts(ms: int): DurationParts {
    const totalSeconds = ms / 1000;
    return new DurationParts(
        days: totalSeconds / 86400,
        hours: totalSeconds % 86400 / 3600,
        minutes: totalSeconds % 3600 / 60,
        seconds: (totalSeconds % 60),
        milliseconds: (ms % 1000),
    );
}

export function formatDurationMs(ms: int): str {
    const seconds = ms / 1000;
    const minutes = seconds / 60;
    const hours = minutes / 60;
    const remSec = seconds % 60;
    const remMin = minutes % 60;
    if(hours > 0) {
        return `${hours}h ${remMin}m ${remSec}s`;
    }
    if(minutes > 0) {
        return `${minutes}m ${remSec}s`;
    }
    return `${seconds}s`;
}
