import { ParseError } from "std:error";
import { env$, setEnv$ } from "runtime:sys";

export namespace Env {
    @capability("sys.env")
    export function get(key: str, defaultVal: str = ""): str {
        return env$(key) ?? defaultVal;
    }

    @capability("sys.env")
    export function set(key: str, val: str): void {
        setEnv$(key, val);
    }

    @capability("sys.env")
    export function has(key: str): bool {
        return env$(key) != null;
    }

    @capability("sys.env")
    export function getInt(key: str, defaultVal: int = 0): int {
        let v = env$(key);
        if(v == null) return defaultVal;
        return int.parse(v as str);
    }

    @capability("sys.env")
    export function getBool(key: str, defaultVal: bool = false): bool {
        let v = env$(key);
        if(v == null) return defaultVal;
        const s = v as str;
        if(s == "true" || s == "1") return true;
        if(s == "false" || s == "0") return false;
        throw new ParseError(`Env.getBool: '${key}' is not a boolean: '${v}'`);
    }

    export function parse(content: str): Map<str, str> {
        const result = new Map<str, str>();
        let lines = content.split("\n");
        for(let line in lines) {
            let trimmed = line.trim();
            if(trimmed.length > 0 && !trimmed.startsWith("#")) {
                let eqIdx = trimmed.indexOf("=");
                if(eqIdx != null) {
                    const ei = eqIdx as int;
                    if(ei > 0) {
                        let key = trimmed.slice(0, ei).trim();
                        let val = trimmed.slice(ei + 1).trim();
                        if(
                            (val.startsWith("\"") && val.endsWith("\"")) ||
                                (val.startsWith("'") && val.endsWith("'"))
                        ) {
                            val = val.slice(1, val.length - 1);
                        }
                        result.set(key, val);
                    }
                }
            }
        }
        return result;
    }
}
