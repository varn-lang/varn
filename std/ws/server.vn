import {
    tcpListen$,
    socketLocalPort$,
    tcpAccept$,
    tcpWrite$,
    tcpClose$,
    tcpCloseListener$,
} from "runtime:net";

import { wsAcceptResponse$ } from "runtime:ws";
import { WebSocket, readHttpHead } from "std:ws/client";
import { ClosedError } from "std:error";

export class WsServer {
    private _listener: int = -1;
    private _port: int;
    private _isListening: bool = false;

    constructor(listener: int) {
        this._listener = listener;
        this._port = socketLocalPort$(listener);
        this._isListening = true;
    }

    @capability("net.server")
    static listen(port: int, host: str = "127.0.0.1"): WsServer {
        return new WsServer(tcpListen$(port, host));
    }

    get port(): int {
        return this._port;
    }

    get isListening(): bool {
        return this._isListening;
    }

    async accept(): Task<WebSocket> {
        if(!this._isListening) {
            throw new ClosedError("server is closed");
        }
        const conn = await tcpAccept$(this._listener);
        try {
            const head = await readHttpHead(conn);
            const res = wsAcceptResponse$(head.head);
            await tcpWrite$(conn, res);
            const ws = new WebSocket(conn, "", true);
            ws.absorb(head.rest);
            return ws;
        } catch(e) {
            try {
                tcpClose$(conn);
            } catch {
                // best effort: the connection may already be closed
            }
            throw e;
        }
    }

    close(): void {
        if(this._isListening) {
            this._isListening = false;
            if(this._listener >= 0) {
                tcpCloseListener$(this._listener);
                this._listener = -1;
            }
        }
    }
}
