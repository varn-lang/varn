import {
    tcpListen$,
    tcpListenTls$,
    socketLocalPort$,
    tcpAccept$,
    tcpConnect$,
    tcpConnectTls$,
    tcpRead$,
    tcpWrite$,
    tcpClose$,
    tcpCloseListener$,
} from "runtime:net";

import { AsyncReader, AsyncWriter } from "std:io";
import { delay } from "std:task";
import { ClosedError, ConnectError, NetError } from "std:error";

export class TcpStream implements AsyncReader, AsyncWriter {
    private _connId: int;
    private _remoteHost: str;
    private _remotePort: int;
    private _isOpen: bool = true;

    constructor(connId: int, remoteHost: str = "127.0.0.1", remotePort: int = 0) {
        this._connId = connId;
        this._remoteHost = remoteHost;
        this._remotePort = remotePort;
    }

    @capability("net.client")
    static async connect(
        host: str,
        port: int,
        attempts: int = 25,
        baseDelayMs: int = 50,
    ): Task<TcpStream> {
        return await TcpStream.open(host, port, false, null, null, attempts, baseDelayMs);
    }

    @capability("net.client")
    static async connectTls(
        host: str,
        port: int,
        ca?: str,
        identity?: str,
        attempts: int = 5,
        baseDelayMs: int = 50,
    ): Task<TcpStream> {
        return await TcpStream.open(host, port, true, ca, identity, attempts, baseDelayMs);
    }

    @capability("net.client")
    private static async open(
        host: str,
        port: int,
        secure: bool,
        ca: str?,
        identity: str?,
        attempts: int,
        baseDelayMs: int,
    ): Task<TcpStream> {
        let attempt = 0;
        let last: NetError = new ConnectError(host, port);
        while(attempt < attempts) {
            try {
                const connId =
                    secure
                        ? await tcpConnectTls$(host, port, ca, identity)
                        : await tcpConnect$(host, port);
                return new TcpStream(connId, host, port);
            } catch(e: NetError) {
                last = e;
            }
            attempt = attempt + 1;
            if(attempt < attempts) {
                await delay(baseDelayMs + attempt * 20);
            }
        }
        throw last;
    }

    get connId(): int {
        return this._connId;
    }

    get remoteHost(): str {
        return this._remoteHost;
    }

    get remotePort(): int {
        return this._remotePort;
    }

    get isOpen(): bool {
        return this._isOpen;
    }

    async read(size: int = 4096): Task<Bytes?> {
        if(!this._isOpen) {
            return null;
        }
        return await tcpRead$(this._connId, size);
    }

    async readText(size: int = 4096): Task<str> {
        const b = await this.read(size);
        if(b == null) {
            return "";
        }
        const valid = b as Bytes;
        return valid.toString();
    }

    async readAll(): Task<Bytes> {
        const chunks: Bytes[] = [];
        let totalLen = 0;
        while(this._isOpen) {
            const chunk = await this.read(4096);
            if(chunk == null) {
                break;
            }
            const valid = chunk as Bytes;
            if(valid.length == 0) {
                break;
            }
            chunks.push(valid);
            totalLen = totalLen + valid.length;
        }
        const merged = Bytes.alloc(totalLen);
        let offset = 0;
        for(let i = 0; i < chunks.length; i = i + 1) {
            const c = chunks[i];
            c.copy(merged, offset);
            offset = offset + c.length;
        }
        return merged;
    }

    async write(data: Bytes | str): Task<int> {
        if(!this._isOpen) {
            throw new ClosedError("socket is closed");
        }
        const b: Bytes = data is str ? Bytes.fromString(data) : data as Bytes;
        try {
            return await tcpWrite$(this._connId, b);
        } catch(e) {
            this.close();
            throw e;
        }
    }

    async writeAll(data: Bytes | str): Task<void> {
        const b: Bytes = data is str ? Bytes.fromString(data) : data as Bytes;
        let offset = 0;
        while(offset < b.length) {
            const chunk = b.slice(offset, b.length);
            const written = await this.write(chunk);
            if(written <= 0) {
                break;
            }
            offset = offset + written;
        }
    }

    async flush(): Task<void> {}

    close(): void {
        if(this._isOpen) {
            tcpClose$(this._connId);
            this._isOpen = false;
        }
    }
}

export class TcpListener {
    private _listenerId: int;
    private _port: int;
    private _host: str;
    private _isListening: bool;

    constructor(listenerId: int, port: int, host: str = "127.0.0.1") {
        this._listenerId = listenerId;
        this._port = port;
        this._host = host;
        this._isListening = listenerId >= 0;
    }

    @capability("net.server")
    static listenTls(
        port: int,
        cert: str,
        key: str,
        host: str = "127.0.0.1",
        clientCa?: str,
    ): TcpListener {
        const id = tcpListenTls$(port, host, cert, key, clientCa);
        return new TcpListener(id, socketLocalPort$(id), host);
    }

    @capability("net.server")
    static listen(port: int, host: str = "127.0.0.1"): TcpListener {
        const id = tcpListen$(port, host);
        return new TcpListener(id, socketLocalPort$(id), host);
    }

    get port(): int {
        return this._port;
    }

    get host(): str {
        return this._host;
    }

    get isListening(): bool {
        return this._isListening;
    }

    async accept(): Task<TcpStream> {
        if(!this._isListening) {
            throw new ClosedError("listener is closed");
        }
        return new TcpStream(await tcpAccept$(this._listenerId), this._host, this._port);
    }

    close(): void {
        if(this._isListening) {
            tcpCloseListener$(this._listenerId);
            this._isListening = false;
        }
    }
}

@capability("net.client")
export async function connect(host: str, port: int): Task<TcpStream> {
    return await TcpStream.connect(host, port);
}

@capability("net.server")
export function listen(port: int, host: str = "127.0.0.1"): TcpListener {
    return TcpListener.listen(port, host);
}
