import { args$ } from "runtime:sys";

export struct ParsedArgs {
    flags: Map<str, str>;
    positionals: str[];
}

export namespace Cli {
    export function parse(rawArgs?: str[]): ParsedArgs {
        const input = rawArgs != null ? rawArgs : args$();
        const flags = new Map<str, str>();
        const positionals: str[] = [];

        for(let i = 0; i < input.length; i = i + 1) {
            const arg = input[i];
            if(arg.startsWith("--")) {
                const body = arg.slice(2);
                const eqIdx = body.indexOf("=");
                if(eqIdx != null) {
                    const ei = eqIdx as int;
                    if(ei > 0) {
                        const k = body.slice(0, ei);
                        const v = body.slice(ei + 1);
                        flags.set(k, v);
                    } else {
                        flags.set(body, "true");
                    }
                } else {
                    flags.set(body, "true");
                }
            } else if(arg.startsWith("-")) {
                const flag = arg.slice(1);
                flags.set(flag, "true");
            } else {
                positionals.push(arg);
            }
        }

        return new ParsedArgs(flags: flags, positionals: positionals);
    }
}
