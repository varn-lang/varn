import { args$ } from "runtime:sys";

export struct ParsedArgs {
    flags: Map<str, str>;
    positionals: str[];
}

export namespace Cli {
    export function parse(rawArgs?: str[]): ParsedArgs {
        let input = rawArgs != null ? rawArgs : args$();
        const flags = new Map<str, str>();
        let positionals: str[] = [];

        for(let i = 0; i < input.length; i = i + 1) {
            let arg = input[i];
            if(arg.startsWith("--")) {
                let body = arg.slice(2);
                let eqIdx = body.indexOf("=");
                if(eqIdx != null) {
                    const ei = eqIdx as int;
                    if(ei > 0) {
                        let k = body.slice(0, ei);
                        let v = body.slice(ei + 1);
                        flags.set(k, v);
                    } else {
                        flags.set(body, "true");
                    }
                } else {
                    flags.set(body, "true");
                }
            } else if (arg.startsWith("-")) {
                let flag = arg.slice(1);
                flags.set(flag, "true");
            } else {
                positionals.push(arg);
            }
        }

        return new ParsedArgs(flags: flags, positionals: positionals);
    }
}
